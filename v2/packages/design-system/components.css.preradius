/* glass badge */

/* cta unified */

/* ============================================================
   لوحة التحكم — الهيكل (Shell) · اتجاه «العائم الزجاجيّ Aurora»
   الشريط الجانبيّ كحليّ دائمًا؛ المحتوى يتبع رموز الثيم.
   ============================================================ */
.ash {
  display: flex;
  min-height: 100vh;
  gap: 14px;
  padding: 14px;
  background: radial-gradient(1200px 440px at 100% -10%,
    color-mix(in oklab, var(--steel-500) 15%, var(--color-bg)), var(--color-bg));
}

/* ---- الشريط الجانبيّ العائم ---- */
.ash-side {
  width: 252px;
  flex: 0 0 auto;
  position: sticky;
  top: 14px;
  align-self: flex-start;
  height: calc(100vh - 28px);
  display: flex;
  flex-direction: column;
  padding: 14px 0;
  overflow: visible; /* ليبرز مقبض التماس خارج الحافّة */
  border-radius: var(--radius);
  color: #c7d3e2;
  /* التوهّج كطبقة خلفية (يُقصّ بالزوايا تلقائيًّا، فلا حاجة لإخفاء الفيض) */
  /* سطح الشريط: الفولاذي والكحلي معًا (لا كحلي منفرد) + توهّج فولاذيّ */
  background:
    radial-gradient(230px 210px at 6% 1%, rgba(111, 151, 192, .38), transparent 60%),
    linear-gradient(160deg, var(--steel-700), var(--navy-900));
  box-shadow: 0 20px 44px -24px rgba(20, 31, 48, .7);
  transition: width var(--dur) var(--ease-standard);
}
/* مقبض التماس — زرّ دائريّ على حدّ الشريط والمحتوى، يتبع الحافّة عند الطيّ */
.ash-handle {
  position: absolute;
  top: 50%;
  left: -13px;
  transform: translateY(-50%);
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text-muted);
  box-shadow: var(--shadow-md);
  cursor: pointer;
  z-index: 6;
  transition: background var(--dur-fast), color var(--dur-fast), transform var(--dur-fast), border-color var(--dur-fast);
}
.ash-handle:hover { color: var(--color-primary); border-color: var(--steel-400); transform: translateY(-50%) scale(1.12); }
.ash-handle svg { width: 15px; height: 15px; transition: transform var(--dur); }
.ash.rail .ash-handle svg { transform: rotate(180deg); }

.ash-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 18px 14px;
  font-size: 16.5px;
  font-weight: 800;
  color: #fff;
  position: relative;
}
.ash-logo {
  width: 34px;
  height: 34px;
  border-radius: var(--radius);
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  font-weight: 800;
  color: #fff;
  background: var(--grad-primary);
}
/* المظهر من مكوّن Button (variant=primary)؛ هنا تخطيط الشريط فقط */
.ash-cta { margin: 0 14px 12px; padding: 10px; border-radius: var(--radius); font-size: 14px; font-weight: 800; }
.ash-cta svg { width: 18px; height: 18px; flex: 0 0 auto; }

.ash-nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-bottom: 6px;
}
.ash-nav-head {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .04em;
  padding: 12px 20px 5px;
  color: #8fa1b8;
}
.ash-i {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  margin: 1px 12px;
  border-radius: var(--radius);
  font-family: inherit;
  font-size: 14.5px;
  font-weight: 700;
  color: #c1cede;
  background: transparent;
  border: 0;
  width: calc(100% - 24px);
  overflow: hidden;
  cursor: pointer;
  text-align: start;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.ash-i svg { width: 19px; height: 19px; flex: 0 0 auto; }
.ash-i .lbl { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity var(--dur-fast); }
.ash-i:hover { background: rgba(255, 255, 255, .07); }
.ash-i.on {
  color: #fff;
  background: linear-gradient(135deg, rgba(111, 151, 192, .34), rgba(39, 64, 96, .22));
  box-shadow: 0 8px 20px -10px rgba(111, 151, 192, .55);
}
.ash-caret {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  opacity: .6;
  transition: transform var(--dur);
}
.ash-i.open .ash-caret { transform: rotate(90deg); }
.ash-b {
  font-style: normal;
  font-family: var(--font-latin);
  font-size: 11px;
  font-weight: 700;
  padding: 1px 7px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, rgba(111, 151, 192, .30), rgba(39, 64, 96, .24));
  color: #e3ecf5;
}
.ash-i .ash-b { margin-inline-start: auto; }

/* أبناء المجموعة (طيّ سلس عبر grid-template-rows) */
.ash-sub {
  display: grid;
  grid-template-rows: 0fr;
  margin: 0 12px;
  padding-inline-start: 30px;
  position: relative;
  transition: grid-template-rows var(--dur) var(--ease-standard);
}
.ash-i.open + .ash-sub { grid-template-rows: 1fr; }
.ash-sub-in { overflow: hidden; }
.ash-sub::before {
  content: "";
  position: absolute;
  inset-inline-start: 20px;
  top: 4px;
  bottom: 10px;
  width: 1.5px;
  background: currentColor;
  opacity: .14;
}
.ash-s {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  margin: 1px 0;
  border-radius: var(--radius);
  font-family: inherit;
  font-size: 13.5px;
  font-weight: 600;
  color: #93a4ba;
  background: transparent;
  border: 0;
  width: 100%;
  cursor: pointer;
  text-align: start;
  position: relative;
  transition: color var(--dur-fast);
}
.ash-s::before {
  content: "";
  position: absolute;
  inset-inline-start: -11px;
  top: 50%;
  transform: translateY(-50%);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0;
  transition: opacity var(--dur-fast);
}
.ash-s .lbl { flex: 1; }
.ash-s:hover { color: #eaf0f6; }
.ash-s.on { color: var(--steel-300); }
.ash-s.on::before { opacity: 1; }
.ash-s .ash-b { margin-inline-start: auto; }

.ash-foot {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 8px 14px 0;
  padding: 10px 12px;
  border-radius: var(--radius);
  color: #dbe4ee;
  background: rgba(255, 255, 255, .06);
  cursor: pointer;
  transition: background var(--dur-fast);
}
.ash-foot:hover { background: rgba(255, 255, 255, .1); }
.ash-fic {
  width: 32px;
  height: 32px;
  border-radius: var(--radius);
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: #dbe6f2;
  background: linear-gradient(135deg, rgba(111, 151, 192, .28), rgba(39, 64, 96, .20));
}
.ash-fic svg { width: 18px; height: 18px; }
.ash-ftx { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
.ash-ftx b { font-size: 13px; font-weight: 800; }
.ash-ftx span { font-size: 11.5px; opacity: .7; }

/* ---- المنطقة الرئيسية ---- */
.ash-main {
  flex: 1;
  min-width: 0;
  height: calc(100vh - 28px);
  display: flex;
  flex-direction: column;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-lg);
}
.ash-top {
  height: 66px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 20px;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-surface);
}
.ash-ham {
  display: none;
  border: 0;
  background: transparent;
  color: var(--color-primary);
  cursor: pointer;
  padding: 4px;
}
.ash-ham svg { width: 24px; height: 24px; }
/* الشريط الجانبيّ ثابت على سطح المكتب (بلا طيّ) — طابع SaaS احترافيّ نظيف.
   الهوية في العلويّ (منطقة لا تنطوي أبدًا) تحقيقًا لقاعدة: الهوية لا تختفي مهما كان. */
.ash-greet { display: flex; align-items: center; gap: 11px; min-width: 0; }
.ash-top > .ash-greet { margin-inline-end: auto; }
/* المظهر من مكوّن Avatar؛ هنا مقاس الشريط فقط (42px بدل 44px الافتراضيّ) — تخصيص أعلى ليغلب .av */
.ash-top .ash-av { width: 42px; height: 42px; }
.ash-gtx { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
.ash-gtx b { font-size: 15.5px; font-weight: 800; color: var(--color-primary); }
.ash-gdate { font-size: 12px; color: var(--color-text-muted); }
.ash-tools { display: flex; align-items: center; gap: 12px; }
.ash-search {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text-muted);
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 8px 12px;
  font-size: 13.5px;
  min-width: 160px;
  cursor: text;
}
.ash-search svg { width: 16px; height: 16px; }
.ash-bell {
  position: relative;
  color: var(--color-text-muted);
  background: transparent;
  border: 0;
  cursor: pointer;
  padding: 4px;
}
.ash-bell svg { width: 20px; height: 20px; }
.ash-bell i {
  position: absolute;
  top: 2px;
  inset-inline-end: 2px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--danger);
}
.ash-content { flex: 1; overflow: auto; padding: 22px; }

/* ---- الطيّ إلى ريّل أيقونات (زرّه أسفل الشريط) ----
   العرض 71px مضبوط ليبقى مركز كلّ أيقونة في مكانه نفسه (هامش 12 + حشو 14 + نصف 9.5 = 35.5).
   لا نغيّر المحاذاة؛ النصوص وحدها تتلاشى فلا تقفز الأيقونات أفقيًّا. */
.ash.rail .ash-side { width: 71px; }
.ash.rail .ash-i .lbl,
.ash.rail .ash-b,
.ash.rail .ash-caret,
.ash.rail .ash-brand b { opacity: 0; pointer-events: none; }
.ash.rail .ash-nav-head { height: 0; padding-block: 0; margin: 0; opacity: 0; overflow: hidden; }
.ash.rail .ash-sub { grid-template-rows: 0fr; }
.ash.rail .ash-cta { gap: 0; }
.ash.rail .ash-cta span { display: none; }
.ash.rail .ash-foot { gap: 0; }
.ash.rail .ash-ftx { display: none; }

/* ---- الجوّال: دُرج منزلق ---- */
.ash-scrim { display: none; }
@media (max-width: 860px) {
  .ash { padding: 0; gap: 0; }
  .ash-main { height: 100vh; border-radius: 0; border: 0; box-shadow: none; }
  .ash-ham { display: block; }
  /* الشريط يصير دُرجًا منزلقًا (الطيّ على الجوّال فقط) */
  .ash-side {
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    left: auto;
    height: 100vh;
    width: 264px;
    border-radius: 0;
    z-index: var(--z-modal);
    /* موجب X = خارج الشاشة يمينًا (لا يتأثّر بالاتجاه) */
    transform: translateX(100%);
    transition: transform var(--dur) var(--ease-standard);
  }
  .ash.mob-open .ash-side { transform: translateX(0); }
  .ash.mob-open .ash-scrim {
    display: block;
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-modal) - 1);
    background: rgba(20, 31, 48, .45);
    backdrop-filter: blur(1px);
  }
  /* ⛔ قاعدة مقدّسة: الاسم + الترحيب + الصورة تبقى ظاهرة دائمًا.
     البحث وحده يتقلّص لأيقونة لتوفير المساحة — لا نُخفي الهوية أبدًا. */
  .ash-search span { display: none; }
  .ash-search { min-width: 0; padding: 8px; }
  .ash-greet { flex: 1; min-width: 0; }
  .ash-gtx b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* على الجوّال الطيّ يكون بإغلاق الدُرج لا بالريّل — نُلغي أثر الريّل ونُخفي المقبض */
  .ash-handle { display: none; }
  .ash.rail .ash-side { width: 264px; }
  .ash.rail .ash-i .lbl,
  .ash.rail .ash-b,
  .ash.rail .ash-caret,
  .ash.rail .ash-brand b { opacity: 1; pointer-events: auto; }
  .ash.rail .ash-nav-head { height: auto; padding: 12px 20px 5px; opacity: 1; }
  .ash.rail .ash-cta { gap: 8px; }
  .ash.rail .ash-cta span,
  .ash.rail .ash-ftx { display: revert; }
  .ash.rail .ash-foot { gap: 10px; }
}
/* في الشاشات الضيّقة جدًّا: التاريخ وحده (غير مقدّس) ينزوي — الاسم والترحيب والصورة تبقى */
@media (max-width: 460px) {
  .ash-gdate { display: none; }
  .ash-gtx b { font-size: 14.5px; }
}

/* ---- رأس الصفحة داخل المحتوى ---- */
.ash-phead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.ash-crumb { font-size: 12px; color: var(--color-text-muted); }
.ash-crumb b { color: var(--color-primary); }
.ash-phead h1 { font-size: 22px; font-weight: 900; color: var(--color-primary); margin-top: 2px; }

/* ============================================================
   جدول البيانات (Data Table) · اتجاه «الشبكة المحاطة بإطار»
   شبكة CSS: أعمدة موحّدة عبر --dt-cols؛ ببادئة .dt
   ============================================================ */
.dt {
  --dt-accent: 69, 113, 154;   /* فولاذيّ 500 افتراضيًّا — يُبدَّل بنغمة الطاولة */
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--color-surface);
  box-shadow: var(--shadow-md);
}
/* حاوية التمرير الأفقيّ — يظهر scroll عند ضيق الجدول عن مجموع محتواه */
.dt-scroll { overflow-x: auto; }
/* شبكة واحدة لكامل الجدول (الصفوف display:contents) → أعمدة محاذاة تُقاس بالمحتوى فلا اقتطاع */
.dt-grid { display: grid; grid-template-columns: var(--dt-cols); min-width: 100%; }
.dt-head, .dt-body, .dt-row { display: contents; }
/* الترويسة: النمط على الخلايا (‏.dt-head/.dt-row‏ صارت بلا صندوق) */
.dt-head .dt-c { background: var(--color-surface-2); border-bottom: 2px solid var(--color-border); font-size: 12px; font-weight: 800; color: var(--color-text-muted); }
/* ترويسة قابلة للفرز */
.dt-sort { display: inline-flex; align-items: center; gap: 5px; background: 0; border: 0; padding: 0; margin: 0; font: inherit; color: inherit; cursor: pointer; transition: color var(--dur-fast); }
.dt-sort svg { width: 14px; height: 14px; opacity: .5; }
.dt-sort:hover { color: var(--color-primary); }
.dt-sort.on, .dt-sort.on svg { color: var(--color-primary); opacity: 1; }
.dt-c {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 12px 14px;
  font-size: 14px;
  font-weight: 600; /* وزن القيم كما في الكروت (demi) */
  color: var(--color-text);
  border-inline-start: 1px solid var(--color-border);
  white-space: nowrap; /* سطر واحد؛ المحتوى كامل بلا «…» — يتّسع العمود ويظهر التمرير عند الحاجة */
  transition: background-color var(--dur) var(--ease-standard); /* تمرير ناعم متدرّج بدل قفزة حادّة */
}
.dt-c:first-child { border-inline-start: 0; }
.dt-c.center { justify-content: center; }
.dt-c.end { justify-content: flex-end; }
.dt-c .txt { white-space: nowrap; }
.dt-c .num { font-family: var(--font-latin); }
/* حدّ الصفّ وتناوبه ومروره — على الخلايا (الصفّ بلا صندوق) */
.dt-body .dt-row .dt-c { border-bottom: 1px solid var(--color-border); }
.dt-body .dt-row:last-child .dt-c { border-bottom: 0; }
/* صفوف متناوبة (Zebra) — الزوجيّة بخلفية خفيفة بلون لكنة الطاولة (فولاذيّ افتراضًا، نغمة إن نُغِّمت) */
.dt-body .dt-row:nth-child(even) .dt-c { background: rgba(var(--dt-accent), .05); }
/* المرور أرقّ من قبل ليتمايز بلطف فوق التخطيط (مع انتقال .dt-c الناعم) */
.dt-body .dt-row:hover .dt-c { background: rgba(var(--dt-accent), .085); }
/* صفّ منغَّم بحالته — تِنت خفيف على الخلايا (يتجاوز التزيبير)، وأقوى قليلًا عند المرور */
.dt-body .dt-row.dt-tone-success .dt-c { background: color-mix(in oklab, var(--success-600) 7%, var(--color-surface)); }
.dt-body .dt-row.dt-tone-warning .dt-c { background: color-mix(in oklab, var(--warning-600) 8%, var(--color-surface)); }
.dt-body .dt-row.dt-tone-danger  .dt-c { background: color-mix(in oklab, var(--danger-600) 7%, var(--color-surface)); }
.dt-body .dt-row.dt-tone-success:hover .dt-c { background: color-mix(in oklab, var(--success-600) 10%, var(--color-surface)); }
.dt-body .dt-row.dt-tone-warning:hover .dt-c { background: color-mix(in oklab, var(--warning-600) 11%, var(--color-surface)); }
.dt-body .dt-row.dt-tone-danger:hover  .dt-c { background: color-mix(in oklab, var(--danger-600) 10%, var(--color-surface)); }
/* الجدول كلّه بنغمة واحدة (طاولة تمثّل حالة واحدة) — الحدّ والظلّ والترويسة والتزيبير والتحويم تتبع النغمة عبر --dt-accent */
.dt.dt-tone-brand   { --dt-accent: 51, 92, 129;  --shadow-tone: 51, 92, 129;  border-color: color-mix(in oklab, var(--steel-600) 26%, var(--color-border)); }
.dt.dt-tone-success { --dt-accent: 26, 132, 82;  --shadow-tone: 26, 132, 82;  border-color: color-mix(in oklab, var(--success-600) 28%, var(--color-border)); }
.dt.dt-tone-warning { --dt-accent: 184, 122, 12; --shadow-tone: 184, 122, 12; border-color: color-mix(in oklab, var(--warning-600) 30%, var(--color-border)); }
.dt.dt-tone-danger  { --dt-accent: 181, 47, 34;  --shadow-tone: 181, 47, 34;  border-color: color-mix(in oklab, var(--danger-600) 30%, var(--color-border)); }
/* ترويسة الطاولة المنغّمة بلون نغمتها */
.dt[class*="dt-tone-"] .dt-head .dt-c {
  background: rgba(var(--dt-accent), .14);
  border-bottom-color: rgba(var(--dt-accent), .34);
  color: color-mix(in oklab, rgb(var(--dt-accent)) 55%, var(--color-text-muted));
}
.dt-body .dt-row.clickable { cursor: pointer; }
/* أفتار الجدول يتبنّى نغمة الطاولة (كاملةً) أو الصفّ (مفردًا): تعبئة بتدرّج النغمة وظلّ بلونها — كأفتار كرت العضو المنغَّم */
.dt.dt-tone-success .av, .dt-body .dt-row.dt-tone-success .av { background: var(--grad-success); --shadow-tone: 26, 132, 82; }
.dt.dt-tone-warning .av, .dt-body .dt-row.dt-tone-warning .av { background: var(--grad-warning); --shadow-tone: 184, 122, 12; }
.dt.dt-tone-danger  .av, .dt-body .dt-row.dt-tone-danger  .av { background: var(--grad-danger);  --shadow-tone: 181, 47, 34; }
/* في اللوح (تُقصّ طبقة التوحيد) يظلّ ظلّ الأفتار فولاذيًّا؛ وفي التطبيق يلتقط الظلّ لون النغمة عبر --shadow-tone */
/* خلية العضو (صورة + اسم + دور) */
.dt-mem { display: flex; align-items: center; gap: 11px; }
/* خلية العضو تستخدم مكوّن Avatar الموحّد (.av) */
.dt-mm { display: flex; flex-direction: column; line-height: 1.3; }
.dt-mm b { font-weight: 800; font-size: 14px; color: var(--color-text); white-space: nowrap; }
/* العنوان الفرعيّ: الدور واللجنة (عربيّ) → Lyon */
.dt-mm span { font-size: 12px; color: var(--color-text-muted); white-space: nowrap; }
/* خانة التحديد — نفس مربّع التصميم المتحرّك (.ach) بمقاس مُصغّر يناسب الصفّ */
.dt-check { justify-content: center; }
.dt-ach { gap: 0; }
.dt-ach .ach-box { width: 18px; height: 18px; border-radius: var(--radius); border-width: 1.5px; border-color: var(--color-border); position: relative; }
.dt-ach .ach-chk { width: 11px; height: 11px; }
/* الحالة الوسطى (تحديد جزئيّ) للترويسة — شرطة بيضاء */
.dt-ach:has(input:indeterminate) .ach-box { background: var(--grad-primary); border-color: transparent; }
.dt-ach:has(input:indeterminate) .ach-box::after {
  content: ""; position: absolute; top: 50%; inset-inline-start: 50%; transform: translate(-50%, -50%);
  width: 9px; height: 2px; border-radius: var(--radius); background: #fff;
}
/* زرّ إجراءات الصفّ */
.dt-dots {
  width: 30px; height: 30px; border-radius: var(--radius); border: 0;
  background: transparent; color: var(--color-text-muted); cursor: pointer;
  display: grid; place-items: center; transition: background var(--dur-fast), color var(--dur-fast);
}
.dt-dots:hover { background: var(--color-surface-2); color: var(--color-primary); }
.dt-dots svg { width: 18px; height: 18px; }

/* ============================================================
   شريط الأدوات (Toolbar) — عنصر منفصل فوق الجدول · بادئة .tb
   config-driven: بحث + مرشّحات (تُمرَّر لكل جدول) + عدّاد + إجراءات جماعية
   ============================================================ */
.tb {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 12px 14px;
  margin-bottom: 14px;
  /* هوية Aurora: تدرّج فولاذيّ ناعم + حدّ ممزوج + ظلّ ملوّن */
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 9%, var(--color-surface)), var(--color-surface) 62%);
  border: 1px solid color-mix(in oklab, var(--steel-600) 10%, var(--color-border));
  border-radius: var(--radius);
  box-shadow: 0 14px 34px -22px rgba(51, 92, 129, 0.42);
}
.tb-search {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 1 300px;
  min-width: 200px;
  padding: 0 12px;
  color: var(--color-text-muted);
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  transition: border-color var(--dur-fast);
}
.tb-search:focus-within { border-color: var(--color-ring); }
.tb-search svg { width: 16px; height: 16px; flex: 0 0 auto; }
.tb-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  font-family: inherit;
  font-size: 13.5px;
  color: var(--color-text);
  padding: 9px 0;
}
.tb-search input::placeholder { color: var(--color-text-muted); }
.tb-actions { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.tb-spacer { flex: 1; }
.tb-count { font-size: 13px; color: var(--color-text-muted); white-space: nowrap; }
.tb-count b { color: var(--color-primary); font-weight: 700; font-family: var(--font-latin); }
.tb-reset { font-family: inherit; font-size: 13px; font-weight: 700; color: var(--danger); background: 0; border: 0; cursor: pointer; }

/* مرشّح منسدل */
.tb-fs { position: relative; }
.tb-fs-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: inherit;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--color-text);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 9px 12px;
  cursor: pointer;
  transition: border-color var(--dur-fast), color var(--dur-fast), background var(--dur-fast);
}
.tb-fs-btn:hover { border-color: var(--steel-400); color: var(--color-primary); }
.tb-fs-btn.on { border-color: var(--steel-500); color: var(--color-primary); background: color-mix(in oklab, var(--steel-500) 8%, var(--color-surface)); }
.tb-fs-btn .val { color: var(--color-primary); }
.tb-fs-btn .chev { width: 15px; height: 15px; color: var(--color-text-muted); transition: transform var(--dur); }
.tb-fs.open .tb-fs-btn .chev { transform: rotate(180deg); }
.tb-fs-panel {
  position: absolute;
  top: calc(100% + 6px);
  inset-inline-start: 0;
  z-index: var(--z-dropdown);
  min-width: 190px;
  padding: 6px;
  /* Aurora — مطابقة لنافذة القائمة */
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 11%, var(--color-surface)), var(--color-surface) 60%);
  border: 1px solid color-mix(in oklab, var(--steel-600) 12%, var(--color-border));
  border-radius: var(--radius);
  box-shadow: 0 18px 40px -22px rgba(51, 92, 129, 0.5), 0 4px 12px -6px rgba(22, 38, 58, 0.18);
}
.tb-fs-opt {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 10px;
  border: 0;
  border-radius: var(--radius);
  background: transparent;
  font-family: inherit;
  font-size: 13.5px;
  color: var(--color-text);
  cursor: pointer;
  text-align: start;
  transition: background var(--dur-fast);
}
.tb-fs-opt:hover { background: var(--color-surface-2); }
.tb-fs-opt.sel { color: var(--color-primary); font-weight: 700; background: color-mix(in oklab, var(--steel-500) 8%, var(--color-surface)); }

/* حالة التحديد: يتحوّل الشريط إلى إجراءات جماعية */
.tb.sel-mode {
  background: linear-gradient(120deg, color-mix(in oklab, var(--steel-500) 14%, var(--color-surface)), var(--color-surface));
  border-color: color-mix(in oklab, var(--steel-500) 30%, var(--color-surface));
}
.tb-selcount { font-size: 13.5px; font-weight: 800; color: var(--color-primary); }
.tb-selcount b { font-family: var(--font-latin); }
.tb-bulk { display: flex; gap: 8px; flex: 1; flex-wrap: wrap; }
.tb-ba {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 7px 12px;
  cursor: pointer;
  transition: border-color var(--dur-fast);
}
.tb-ba svg { width: 16px; height: 16px; }
.tb-ba:hover { border-color: var(--steel-400); }
.tb-ba.dg { color: var(--danger); border-color: color-mix(in oklab, var(--danger) 30%, var(--color-surface)); }
.tb-bulk-x { display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: 13px; font-weight: 700; color: var(--color-text-muted); background: 0; border: 0; cursor: pointer; }
.tb-bulk-x svg { width: 15px; height: 15px; }

/* ============================================================
   القائمة المنسدلة (Dropdown Menu) · اتجاه «أيقونات + مجموعات»
   تُعرض عبر Portal لتفادي قصّ حاويات overflow. بادئة .dm
   ============================================================ */
.dm-trigger {
  width: 30px; height: 30px; border-radius: var(--radius); border: 0;
  background: transparent; color: var(--color-text-muted); cursor: pointer;
  display: grid; place-items: center;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.dm-trigger:hover, .dm-trigger[aria-expanded="true"] { background: var(--color-surface-2); color: var(--color-primary); }
.dm-trigger svg { width: 18px; height: 18px; }

.dm-menu {
  /* التموضع من Radix (تحويل داخليّ)؛ هنا المظهر فقط */
  min-width: 210px;
  max-height: min(80vh, var(--radix-dropdown-menu-content-available-height, 80vh));
  overflow: auto;
  padding: 6px;
  /* هوية Aurora: تدرّج فولاذيّ ناعم على السطح + حدّ ممزوج + ظلّ ملوّن */
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 11%, var(--color-surface)), var(--color-surface) 60%);
  border: 1px solid color-mix(in oklab, var(--steel-600) 12%, var(--color-border));
  border-radius: var(--radius);
  box-shadow: 0 18px 40px -22px rgba(51, 92, 129, 0.5), 0 4px 12px -6px rgba(22, 38, 58, 0.18);
  z-index: var(--z-dropdown);
  --shadow-tone: 51, 92, 129;   /* فولاذيّ 600 — لون التحويم الافتراضيّ (يُبدَّل بالنغمة) */
  transform-origin: var(--radix-dropdown-menu-content-transform-origin);
  animation: dm-in var(--dur-fast) var(--ease-standard);
}
/* شفافية فقط (لا transform) كي لا يزاحم تموضع Radix */
@keyframes dm-in { from { opacity: 0; } to { opacity: 1; } }
.dm-item[data-highlighted] { background: rgba(var(--shadow-tone), .12); color: rgb(var(--shadow-tone)); outline: none; }
.dm-item[data-highlighted] .dm-ic { color: rgb(var(--shadow-tone)); }
.dm-item.dg[data-highlighted] { background: color-mix(in oklab, var(--danger) 11%, var(--color-surface)); color: var(--danger); }
.dm-hd { font-size: 11px; font-weight: 800; color: color-mix(in oklab, rgb(var(--shadow-tone)) 50%, var(--color-text-muted)); padding: 6px 11px 3px; }
.dm-hd.dg { color: var(--danger); }
.dm-sep { height: 1px; background: color-mix(in oklab, var(--steel-500) 20%, var(--color-border)); margin: 5px 4px; }
.dm-item {
  display: flex; align-items: center; gap: 10px; width: 100%;
  padding: 9px 11px; border: 0; border-radius: var(--radius); background: 0;
  font-family: inherit; font-size: 13.5px; font-weight: 600;
  /* نغمة هادئة: النغمة ممزوجة بالنصّ الداكن — بنفس سكون الكحليّ لكن بلون القائمة */
  color: color-mix(in oklab, rgb(var(--shadow-tone)) 50%, var(--color-text)); cursor: pointer; text-align: start;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.dm-ic { display: grid; place-items: center; color: color-mix(in oklab, rgb(var(--shadow-tone)) 50%, var(--color-text-muted)); flex: 0 0 auto; }
.dm-ic svg { width: 18px; height: 18px; }
.dm-item:hover {
  background: rgba(var(--shadow-tone), .12);
  color: rgb(var(--shadow-tone));
}
.dm-item:hover .dm-ic { color: rgb(var(--shadow-tone)); }
.dm-item.dg { color: var(--danger); }
.dm-item.dg .dm-ic { color: var(--danger); }
.dm-item.dg:hover { background: color-mix(in oklab, var(--danger) 11%, var(--color-surface)); color: var(--danger); }
.dm-item.disabled { opacity: .5; cursor: not-allowed; }
/* خلفية القائمة بلون الحالة (سطح Aurora منغَّم + حدّ + ظلّ) — الافتراضيّ فولاذيّ.
   الظلّ يتلوّن تلقائيًّا لأن طبقة التوحيد تقرأ --shadow-tone من العنصر. */
.dm-menu.dm-tone-success { background: linear-gradient(135deg, #e4f3ec, var(--color-surface) 60%); border-color: color-mix(in oklab, var(--success-600) 20%, var(--color-border)); --shadow-tone: 26, 132, 82; }
.dm-menu.dm-tone-warning { background: linear-gradient(135deg, #faf2e2, var(--color-surface) 60%); border-color: color-mix(in oklab, var(--warning-600) 22%, var(--color-border)); --shadow-tone: 184, 122, 12; }
.dm-menu.dm-tone-danger  { background: linear-gradient(135deg, #fae7e6, var(--color-surface) 60%); border-color: color-mix(in oklab, var(--danger-600) 22%, var(--color-border)); --shadow-tone: 181, 47, 34; }

/* ============================================================
   النافذة (Modal) · حواريّة مركزيّة · بادئة .mdl
   overflow مرئيّ ليظهر منسدل Select كاملًا؛ الزوايا مُدوّرة بالرأس/التذييل.
   ============================================================ */
/* الطبقة (Radix Overlay) — خلفيّة فقط؛ التوسيط على اللوح نفسه */
.mdl-scrim {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  background: rgba(20, 31, 48, .42);
  backdrop-filter: blur(2px);
}
.mdl-scrim[data-state="open"] { animation: mdl-fade var(--dur) var(--ease-standard); }
.mdl-scrim[data-state="closed"] { animation: mdl-fade-out var(--dur) var(--ease-standard); }
/* اللوح (Radix Content) — مثبّت وموسّط بنفسه */
.mdl {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: var(--z-modal);
  display: flex;
  flex-direction: column;
  width: calc(100vw - 40px);
  max-height: calc(100dvh - 40px); /* لا تتجاوز الشاشة؛ الجسم يُمرّر داخليًّا */
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: 0 30px 70px -20px rgba(20, 31, 48, .55);
}
.mdl-sm { max-width: 400px; }
.mdl-md { max-width: 520px; }
.mdl-lg { max-width: 720px; }
.mdl:focus-visible { outline: none; }
@keyframes mdl-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes mdl-fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes mdl-pop { from { opacity: 0; transform: translate(-50%, -50%) translateY(8px) scale(.985); } to { opacity: 1; transform: translate(-50%, -50%); } }
@keyframes mdl-pop-out { from { opacity: 1; transform: translate(-50%, -50%); } to { opacity: 0; transform: translate(-50%, -50%) translateY(6px) scale(.985); } }
/* دورة الحياة: دخول عند الفتح وخروج عند الإغلاق — اسمان مختلفان ليكتشف Radix حركة الخروج فيُبقي العنصر حتى تنتهي */
.mdl[data-state="open"] { animation: mdl-pop var(--dur) var(--ease-standard); }
.mdl[data-state="closed"] { animation: mdl-pop-out var(--dur) var(--ease-standard); }
@media (prefers-reduced-motion: reduce) { .mdl[data-state], .mdl-scrim[data-state] { animation: none; } }
.mdl-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 20px 14px;
  border-bottom: 1px solid var(--color-border);
  border-radius: var(--radius) var(--radius) 0 0;
  flex: 0 0 auto; /* ثابتة أعلى النافذة */
}
.mdl-title { font-size: 18px; font-weight: 900; color: var(--color-primary); }
.mdl-desc { font-size: 13px; color: var(--color-text-muted); margin-top: 2px; }
/* مخفيّ بصريًّا لكنه متاح لقارئ الشاشة (عنوان Radix الإلزاميّ عند غيابه) */
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.mdl-x {
  width: 34px; height: 34px; flex: 0 0 auto; border: 0; border-radius: var(--radius);
  background: var(--color-surface-2); color: var(--color-text-muted); cursor: pointer;
  display: grid; place-items: center; transition: background var(--dur-fast), color var(--dur-fast);
}
.mdl-x svg { width: 17px; height: 17px; }
.mdl-x:hover { background: color-mix(in oklab, var(--steel-500) 12%, var(--color-surface)); color: var(--color-primary); }
.mdl-body { padding: 18px 20px; flex: 1 1 auto; min-height: 0; overflow-y: auto; }
.mdl-foot {
  display: flex; justify-content: flex-end; gap: 10px;
  padding: 14px 20px;
  flex: 0 0 auto; /* ثابت أسفل النافذة */
  border-top: 1px solid var(--color-border);
  background: color-mix(in oklab, var(--steel-500) 3%, var(--color-surface));
  border-radius: 0 0 var(--radius) var(--radius);
}
.mdl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 520px) { .mdl-grid { grid-template-columns: 1fr; } }
.mdl-full { grid-column: 1 / -1; }
.mdl-fieldlabel { display: block; font-size: 12.5px; font-weight: 700; color: var(--color-text-muted); margin-bottom: 6px; }
.mdl-seg { display: inline-flex; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 3px; gap: 2px; width: max-content; }
.mdl-seg button { font-family: inherit; font-size: 13px; font-weight: 700; color: var(--color-text-muted); background: 0; border: 0; border-radius: var(--radius); padding: 7px 15px; cursor: pointer; transition: color var(--dur-fast); }
.mdl-seg button.on { background: var(--color-surface); color: var(--color-primary); box-shadow: 0 2px 6px -2px rgba(51, 92, 129, .4); }

/* ============================================================
   الترقيم (Pagination) — تذييل الجدول · بادئة .pag
   ============================================================ */
.dt-foot { border-top: 1px solid var(--color-border); }
.pag {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  padding: 12px 16px;
  background: color-mix(in oklab, var(--steel-500) 2%, var(--color-surface));
}
.pag-left { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.pag-rpp { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-muted); }
.pag-size {
  font-family: inherit; font-weight: 700; font-size: 13px; color: var(--color-text);
  background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius);
  padding: 6px 10px; cursor: pointer;
}
.pag-size:hover { border-color: var(--steel-400); }
.pag-rng { font-size: 13px; color: var(--color-text-muted); }
.pag-rng b { color: var(--color-primary); font-weight: 700; font-family: var(--font-latin); }
.pag-nav { display: flex; align-items: center; gap: 6px; }
.pag-arr {
  width: 34px; height: 34px; display: grid; place-items: center;
  border: 1px solid var(--color-border); border-radius: var(--radius);
  background: var(--color-surface); color: var(--color-text-muted); cursor: pointer;
  transition: border-color var(--dur-fast), color var(--dur-fast);
}
.pag-arr svg { width: 16px; height: 16px; }
.pag-arr:hover:not(:disabled) { border-color: var(--steel-400); color: var(--color-primary); }
.pag-arr:disabled { opacity: .45; cursor: not-allowed; }
.pag-num {
  min-width: 34px; height: 34px; padding: 0 6px;
  border: 1px solid var(--color-border); border-radius: var(--radius);
  background: var(--color-surface); color: var(--color-text);
  font-family: var(--font-latin); font-size: 13.5px; font-weight: 700; cursor: pointer;
  transition: border-color var(--dur-fast), color var(--dur-fast);
}
.pag-num:hover { border-color: var(--steel-400); color: var(--color-primary); }
.pag-num.on {
  background: var(--grad-primary);
  color: #fff; border-color: transparent;
  box-shadow: 0 6px 14px -8px rgba(51, 92, 129, .7);
}
.pag-dot { color: var(--color-text-muted); padding: 0 2px; }

/* ============================================================
   الصورة الرمزية (Avatar) — مربّع بزوايا مستديرة وحدّ · بادئة .av
   ============================================================ */
.av {
  position: relative;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 44px;
  height: 44px;
  border-radius: var(--radius); /* نسبة من الحجم — كل الأفتار نفس المربّع المدوّر */
  color: #fff;
  /* الأحرف عربيّة → خطّ الهوية العربيّ (Lyon)، لا Eras اللاتينيّ (كان يسرّب لخطّ المتصفّح) */
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  background: var(--grad-primary);
  box-shadow: 0 4px 10px -4px rgba(51, 92, 129, .5), inset 0 0 0 1px rgba(255, 255, 255, .2);
  user-select: none;
}
.av-xs { width: 28px; height: 28px; border-radius: var(--radius); font-size: 11px; }
.av-sm { width: 36px; height: 36px; border-radius: var(--radius); font-size: 13px; }
.av-lg { width: 60px; height: 60px; border-radius: var(--radius); font-size: 20px; }
.av-xl { width: 70px; height: 70px; border-radius: var(--radius); font-size: 23px; }
.av-img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: inherit; }
.av-ini { line-height: 1; }
/* أداة: نصّ لاتينيّ صريح بخط Eras (للبريد/الأرقام خارج الجدول) */
.lat { font-family: var(--font-latin); }
/* أدوات تعبئة العلامة — تدرّج الهوية الزاويّ بدل تعبئة كحلية/فولاذية صلبة */
.bg-brand { background: var(--grad-primary); }
.bg-brand-strong { background: var(--grad-primary-strong); }
/* نصّ «غير متوفّر» — عربيّ باهت (لا يأخذ .lat كي لا يتسرّب خطّه) */
.na { color: var(--color-text-muted); font-weight: 500; }
.av-dot {
  position: absolute;
  bottom: -1px;
  inset-inline-start: -1px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--color-surface);
}
.av-xs .av-dot, .av-sm .av-dot { width: 10px; height: 10px; }
.av-dot-online { background: var(--grad-success); }
.av-dot-away { background: var(--grad-warning); }
.av-dot-busy { background: var(--grad-danger); }
.av-dot-offline { background: var(--neutral-400); }

/* ============================================================
   التبويبات (Tabs) · underline | pill | segmented · بادئة .tabs
   ============================================================ */
.tabs { display: flex; gap: 4px; }
.tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  font-family: inherit;
  font-weight: 700;
  color: var(--color-text-muted);
  background: 0;
  border: 0;
  cursor: pointer;
  transition: color var(--dur-fast), background var(--dur-fast);
}
.tab-b {
  font-style: normal;
  font-family: var(--font-latin);
  font-size: 11px;
  font-weight: 700;
  padding: 1px 7px;
  border-radius: var(--radius-full);
  margin-inline-start: 7px;
  background: color-mix(in oklab, var(--steel-500) 16%, var(--color-surface));
  color: var(--steel-600);
}
.tabs-underline { gap: 4px; padding: 0 4px; border-bottom: 1px solid var(--color-border); }
.tabs-underline .tab { font-size: 14px; padding: 13px 14px; }
.tabs-underline .tab:hover { color: var(--color-primary); }
.tabs-underline .tab.on { color: var(--color-primary); }
.tabs-underline .tab.on::after {
  content: ""; position: absolute; inset-inline: 10px; bottom: -1px; height: 3px;
  border-radius: var(--radius-full) var(--radius-full) 0 0; background: var(--grad-primary);
}
.tabs-pill { gap: 6px; flex-wrap: wrap; }
.tabs-pill .tab { font-size: 13.5px; border-radius: var(--radius); padding: 9px 15px; }
.tabs-pill .tab:hover { background: var(--color-surface-2); color: var(--color-primary); }
.tabs-pill .tab.on { color: #fff; background: var(--grad-primary); box-shadow: 0 8px 18px -10px rgba(51, 92, 129, .7); }
.tabs-pill .tab.on .tab-b { background: rgba(255, 255, 255, .22); color: #fff; }
.tabs-segmented { display: inline-flex; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 4px; gap: 2px; }
.tabs-segmented .tab { font-size: 13.5px; border-radius: var(--radius); padding: 8px 15px; }
.tabs-segmented .tab:hover { color: var(--color-primary); }
.tabs-segmented .tab.on { background: var(--color-surface); color: var(--color-primary); box-shadow: 0 2px 8px -3px rgba(51, 92, 129, .5); }
.tabs-segmented .tab.on .tab-b { background: color-mix(in oklab, var(--steel-500) 16%, var(--color-surface)); }

/* لوحة تبويب داخل النافذة + قائمة معلومات (لعرض الملف) */
.mdl-tabpanel { padding-top: 16px; }
/* نافذة الملف الشخصيّ — Aurora: بطاقة هويّة + أقسام، كلّ قسم بطاقة ناعمة فيها صفوف بفواصل خفيفة */
/* النسخة القديمة (بادئة .pv) من نافذة عرض البيانات حُذفت — استُبدلت بتصميم .pvb و .pva المطوَّر أدناه */

/* ===== نافذة عرض بيانات العضو (للقراءة) — غلاف منقوش + أفتار مربّع + شبكة خلايا بنسخ ===== */
.pvb-modal { overflow: hidden; }
.pvb-modal .mdl-body { padding-top: 52px; }
.pvb-cover { height: 94px; background: var(--grad-primary); position: relative; overflow: hidden; flex: 0 0 auto; }
.pvb-cover::after { content: ""; position: absolute; inset: 0; background: url("/brand/pattern-white.svg") no-repeat center / 135%; opacity: .13; pointer-events: none; }
.pvb-cover .mdl-x { position: absolute; top: 12px; inset-inline-end: 12px; color: #fff; background: rgba(255,255,255,.18); }
.pvb-cover .mdl-x:hover { background: rgba(255,255,255,.32); color: #fff; }
.pvb-av { position: absolute; top: 49px; left: 50%; transform: translateX(-50%); width: 90px; height: 90px; border-radius: var(--radius); background: var(--grad-primary); color: #fff; display: grid; place-items: center; font-size: 29px; font-weight: 800; font-family: var(--font-display); border: 4px solid var(--color-surface); box-shadow: 0 14px 28px -10px rgba(20,31,48,.55); z-index: 3; }
.pvb-dot { position: absolute; bottom: 2px; inset-inline-start: 2px; width: 18px; height: 18px; border-radius: 50%; background: var(--grad-success); border: 3px solid var(--color-surface); }
.pvb-name { text-align: center; font-size: 20px; font-weight: 800; color: var(--color-primary); }
.pvb-role { text-align: center; font-size: 13px; color: var(--color-text-muted); margin-top: 3px; }
.pvb-badges { display: flex; justify-content: center; margin: 11px 0 4px; }
.pva-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; margin-top: 22px; }
.pva-cell { position: relative; background: var(--surface-aurora); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 11px 13px; min-width: 0; }
.pva-cell.full { grid-column: 1 / -1; }
.pva-lbl { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--color-text-muted); }
.pva-lic { width: 15px; height: 15px; color: var(--steel-600); flex: 0 0 auto; display: inline-flex; }
.pva-lic svg { width: 100%; height: 100%; }
.pva-val { font-size: 14px; font-weight: 700; margin-top: 4px; color: var(--color-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pva-val.na { color: var(--color-text-muted); font-weight: 600; }
.pva-copy { position: absolute; top: 8px; inset-inline-end: 8px; width: 26px; height: 26px; border-radius: var(--radius); display: grid; place-items: center; color: var(--color-text-muted); background: transparent; border: 0; cursor: pointer; opacity: .5; transition: opacity var(--dur-fast), background var(--dur-fast), color var(--dur-fast); }
.pva-copy:hover { opacity: 1; background: color-mix(in oklab, var(--steel-500) 14%, transparent); color: var(--color-primary); }
.pva-copy.done { opacity: 1; color: var(--success-600); background: color-mix(in oklab, var(--success-600) 16%, transparent); }
.pva-copy svg { width: 15px; height: 15px; }
.pva-copy .ic-check { display: none; }
.pva-copy .ic-check svg path { stroke-dasharray: 24; stroke-dashoffset: 24; }
.pva-copy.done .ic-copy { display: none; }
.pva-copy.done .ic-check { display: block; animation: copy-pop .34s var(--ease-standard); }
.pva-copy.done .ic-check svg path { animation: copy-draw .42s var(--ease-standard) .04s forwards; }
@keyframes copy-draw { to { stroke-dashoffset: 0; } }
@keyframes copy-pop { 0% { transform: scale(.3); } 55% { transform: scale(1.18); } 100% { transform: scale(1); } }

/* ===== النافذة الاستثنائيّة (تنبيه/تأكيد) — نغمة الحالة + أيقونة متحرّكة بمعناها + أزرار ممتدّة ===== */
.mdl-tone-danger  { --surface-aurora: linear-gradient(135deg, #fae7e6, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--danger-600) 32%, var(--color-border)); --shadow-tone: 181, 47, 34; }
.mdl-tone-warning { --surface-aurora: linear-gradient(135deg, #faf2e2, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--warning-600) 32%, var(--color-border)); --shadow-tone: 184, 122, 12; }
.mdl-tone-success { --surface-aurora: linear-gradient(135deg, #e4f3ec, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--success-600) 30%, var(--color-border)); --shadow-tone: 26, 132, 82; }
.mdl-tic { width: 54px; height: 54px; border-radius: var(--radius); display: grid; place-items: center; flex: 0 0 auto; color: #fff; box-shadow: 0 8px 18px -8px rgba(var(--shadow-tone), .55); position: relative; }
.mdl-tic svg { width: 26px; height: 26px; }
.mdl-tone-danger .mdl-tic  { background: var(--grad-danger); }
.mdl-tone-warning .mdl-tic { background: var(--grad-warning); }
.mdl-tone-success .mdl-tic { background: var(--grad-success); }
.mdl-tone-danger .mdl-title  { color: var(--danger-700); }
.mdl-tone-warning .mdl-title { color: var(--warning-700); }
.mdl-tone-success .mdl-title { color: var(--success-700); }
.mdl-alert .mdl-body { text-align: center; padding: 30px 26px 12px; }
.mdl-alert .mdl-tic { margin: 0 auto 15px; }
.mdl-alert .mdl-title { font-size: 19px; }
.mdl-alert .mdl-atext { font-size: 14px; line-height: 1.8; color: var(--color-text-muted); margin-top: 9px; }
.mdl-alert .mdl-foot { justify-content: stretch; gap: 10px; border-top: 0; background: transparent; padding: 6px 22px 22px; }
.mdl-alert .mdl-foot .abtn { flex: 1; }
/* حركة الأيقونة حسب معنى الحالة: نجاح يُعيد رسم الصح · تحذير يتأرجح · خطر يرتجف */
@keyframes tic-appear { from { transform: scale(.55); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.mdl-tone-success .mdl-tic { animation: tic-appear .3s var(--ease-standard) both; }
.mdl-tone-success .mdl-tic svg path { stroke-dasharray: 24; stroke-dashoffset: 24; animation: tic-draw 1.5s var(--ease-standard) infinite; }
@keyframes tic-draw { 0% { stroke-dashoffset: 24; } 38% { stroke-dashoffset: 0; } 72% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 24; } }
.mdl-tone-warning .mdl-tic { animation: tic-appear .3s var(--ease-standard) both, tic-sway 1.7s ease-in-out .3s infinite; }
@keyframes tic-sway { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
.mdl-tone-danger .mdl-tic { animation: tic-appear .3s var(--ease-standard) both, tic-shake 1.3s ease-in-out .3s infinite; }
@keyframes tic-shake { 0%, 100% { transform: translateX(0) rotate(0); } 12% { transform: translateX(-2.5px) rotate(-3deg); } 28% { transform: translateX(2.5px) rotate(3deg); } 44% { transform: translateX(-2px) rotate(-2deg); } 60% { transform: translateX(2px) rotate(2deg); } 76% { transform: translateX(-1.4px) rotate(-1deg); } 88% { transform: translateX(1.2px); } }
@media (prefers-reduced-motion: reduce) { .mdl-alert .mdl-tic { animation: none; } .mdl-tone-success .mdl-tic svg path { animation: none; stroke-dashoffset: 0; } }
.mdl-info { display: flex; flex-direction: column; }
.mdl-info-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--color-border); font-size: 14px; }
.mdl-info-row:last-child { border-bottom: 0; }
.mdl-info-row dt { color: var(--color-text-muted); }
.mdl-info-row dd { color: var(--color-text); font-weight: 600; }
.mdl-muted { color: var(--color-text-muted); font-size: 14px; }

/* ============================================================
   الحالة الفارغة (Empty State) · soft | aurora · بادئة .empty
   ============================================================ */
.dt-empty { padding: 0; grid-column: 1 / -1; }
.empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 46px 24px; }
.empty-ic { display: grid; place-items: center; margin-bottom: 14px; }
.empty-title { font-size: 16.5px; font-weight: 800; color: var(--color-primary); }
.empty-desc { font-size: 13.5px; color: var(--color-text-muted); max-width: 360px; margin-top: 4px; }
.empty-action { margin-top: 16px; }
.empty-soft .empty-ic {
  width: 60px; height: 60px; border-radius: var(--radius);
  color: var(--steel-600);
  background: color-mix(in oklab, var(--steel-500) 12%, var(--color-surface));
  border: 1px solid color-mix(in oklab, var(--steel-500) 20%, var(--color-surface));
}
.empty-soft .empty-ic svg { width: 28px; height: 28px; }
.empty-aurora .empty-ic {
  position: relative;
  width: 72px; height: 72px; border-radius: var(--radius);
  color: #fff;
  background: var(--grad-primary);
  box-shadow: 0 16px 34px -14px rgba(51, 92, 129, .7);
  margin-bottom: 16px;
}
.empty-aurora .empty-ic svg { width: 32px; height: 32px; }
.empty-aurora .empty-ic::after {
  content: ""; position: absolute; inset: -18px; border-radius: 50%;
  background: radial-gradient(circle, rgba(111, 151, 192, .45), transparent 65%);
  filter: blur(14px); z-index: -1;
}

/* ============================================================
   هيكل التحميل (Skeleton) · لمعان منزلق · بادئة .sk
   ============================================================ */
.sk {
  display: block;
  height: 12px;
  border-radius: var(--radius);
  background: linear-gradient(90deg,
    var(--color-surface-2) 25%,
    color-mix(in oklab, #fff 55%, var(--color-surface-2)) 50%,
    var(--color-surface-2) 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s linear infinite;
}
.sk-av { width: 36px; height: 36px; border-radius: var(--radius); flex: 0 0 auto; }
@keyframes sk-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
@media (prefers-reduced-motion: reduce) {
  .sk { animation: none; background: var(--color-surface-2); }
}

/* ============================================================
   الإشعارات (Toast) · اتجاه «أيقونة مربّعة + Aurora» · بادئة .toast
   ============================================================ */
.toast-stack {
  position: fixed;
  bottom: 24px;
  inset-inline-start: 24px;
  z-index: var(--z-toast);
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: min(380px, calc(100vw - 48px));
}
.toast {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  box-shadow: 0 16px 36px -18px rgba(20, 31, 48, .4);
  animation: toast-in var(--dur) var(--ease-standard);
}
@keyframes toast-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
.tic { width: 34px; height: 34px; flex: 0 0 auto; border-radius: var(--radius); display: grid; place-items: center; color: #fff; }
.tic svg { width: 19px; height: 19px; }
.tmsg { flex: 1; font-size: 14px; font-weight: 600; color: var(--color-text); }
.tx { width: 28px; height: 28px; flex: 0 0 auto; border: 0; background: 0; color: var(--color-text-muted); cursor: pointer; border-radius: var(--radius); display: grid; place-items: center; transition: background var(--dur-fast); }
.tx svg { width: 15px; height: 15px; }
.tx:hover { background: var(--color-surface-2); }
.tprog {
  position: absolute; bottom: 0; inset-inline-end: 0; height: 3px; width: 100%;
  animation-name: toast-prog; animation-timing-function: linear; animation-fill-mode: forwards;
}
.toast:hover .tprog { animation-play-state: paused; }
@keyframes toast-prog { from { width: 100%; } to { width: 0; } }
@media (prefers-reduced-motion: reduce) { .toast { animation: none; } }

/* النبرات */
.tt-success { background: linear-gradient(120deg, color-mix(in oklab, var(--success) 10%, var(--color-surface)), var(--color-surface)); }
.tt-success .tic { background: var(--grad-success); box-shadow: 0 6px 14px -6px color-mix(in oklab, var(--success) 70%, transparent); }
.tt-success .tprog { background: var(--grad-success); }
.tt-error { background: linear-gradient(120deg, color-mix(in oklab, var(--danger) 10%, var(--color-surface)), var(--color-surface)); }
.tt-error .tic { background: var(--grad-danger); box-shadow: 0 6px 14px -6px color-mix(in oklab, var(--danger) 70%, transparent); }
/* توست الخطأ دائم: بلا شريط تقدّم — يبقى حتى يُغلقه المستخدم بالأكس (وعلى دالّة التوست ألّا تضبط له مؤقّتًا) */
.tt-error .tprog { display: none; }
.tt-info { background: linear-gradient(120deg, color-mix(in oklab, var(--info) 12%, var(--color-surface)), var(--color-surface)); }
.tt-info .tic { background: var(--grad-primary); box-shadow: 0 6px 14px -6px color-mix(in oklab, var(--info) 70%, transparent); }
.tt-info .tprog { background: var(--grad-primary); }
.tt-warning { background: linear-gradient(120deg, color-mix(in oklab, var(--warning) 12%, var(--color-surface)), var(--color-surface)); }
.tt-warning .tic { background: var(--grad-warning); box-shadow: 0 6px 14px -6px color-mix(in oklab, var(--warning) 70%, transparent); }
.tt-warning .tprog { background: var(--grad-warning); }

