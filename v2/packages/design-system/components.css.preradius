/* ============================================================
   معرض المكوّنات (/dashboard/components) — سقالة عرض للمراجعة الشاملة.
   بادئة .gal — لا تمسّ أنماط المكوّنات نفسها.
   ============================================================ */
.gal { display: flex; flex-direction: column; gap: 26px; padding-bottom: 60px; }
/* فهرس قافز */
.gal-toc { display: flex; flex-wrap: wrap; gap: 8px; }
.gal-toc a {
  font-size: 12.5px; font-weight: 600; color: var(--color-text-muted);
  padding: 7px 13px; border-radius: var(--radius-full); text-decoration: none;
  border: 1px solid var(--color-border);
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 8%, var(--color-surface)), var(--color-surface) 70%);
  transition: color var(--dur-fast), border-color var(--dur-fast), transform var(--dur-fast);
}
.gal-toc a:hover { color: var(--color-primary); border-color: var(--navy-700); transform: translateY(-1px); }
/* قسم = بطاقة Aurora */
.gal-sec {
  scroll-margin-top: 88px;
  border-radius: var(--radius); padding: 24px;
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 10%, var(--color-surface)), var(--color-surface) 64%);
  border: 1px solid color-mix(in oklab, var(--steel-600) 10%, var(--color-border));
  box-shadow: 0 16px 40px -26px rgba(51, 92, 129, 0.4);
}
.gal-sec-hd { display: flex; align-items: center; gap: 13px; margin-bottom: 20px; }
.gal-num {
  width: 34px; height: 34px; flex: 0 0 auto; border-radius: var(--radius);
  display: grid; place-items: center; font-weight: 700; font-size: 15px; color: #fff;
  background: var(--grad-primary-strong);
  box-shadow: 0 8px 18px -8px rgba(39, 64, 96, 0.6);
}
.gal-sec-hd h2 { font-size: 19px; font-weight: 700; line-height: 1.2; }
.gal-sec-hd p { font-size: 13px; color: var(--color-text-muted); margin-top: 2px; }
/* مجموعات المعاينة */
.gal-block { display: flex; flex-direction: column; gap: 12px; }
.gal-block + .gal-block { margin-top: 22px; padding-top: 20px; border-top: 1px dashed var(--color-border); }
.gal-lbl { font-size: 12px; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.02em; }
.gal-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
.gal-col { display: flex; flex-direction: column; gap: 14px; max-width: 420px; }
/* لوح معاينة داكن قليلاً لإبراز العناصر الفاتحة (مثل inverse) */
.gal-dark {
  background: linear-gradient(135deg, var(--navy-800), var(--steel-800));
  border-radius: var(--radius); padding: 18px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
}
/* شبكة صور رمزية / بطاقات */
.gal-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
@media (max-width: 640px) { .gal-sec { padding: 18px; } }

/* ============================================================
   كروت الإحصائيات (KPI) — سطح Aurora · أيقونة بتدرّج النغمة · رقم Eras · مؤشّر اتّجاه.
   النغمة تُبدَّل بـ‎.stat-brand/-success/-warning/-danger‎ (تدرّج الأيقونة + لون الظلّ).
   ============================================================ */
/* شبكة الإحصائيات — flex بأساس ⅓ ونموّ يحقّق ثلاث قواعد تلقائيًّا:
   (1) الكرت الوحيد يملأ الصف · (2) ثلاثة كحدّ أقصى وتقلّ حسب العرض (min-width) · (3) اليتيم في الصف الأخير يمتدّ على كامله.
   الأساس ⅓ يضمن ألّا يزيد الصف عن ثلاثة (ثلاثة تملأ 100% فلا يبقى مكان لرابع)، والنموّ يملأ أيّ صفّ ناقص. */
.stat-grid { display: flex; flex-wrap: wrap; gap: 16px; }
/* أساس ⅓ بلا انكماش (shrink:0) — ثلاثة تملأ الصفّ تمامًا فيُجبَر الرابع على النزول (سقف 3)؛
   والنموّ (grow:1) يملأ أيّ صفّ ناقص؛ وmin-width يُنقص العدد على الشاشات الضيّقة. */
.stat-grid > * { flex: 1 0 calc((100% - 32px) / 3); min-width: 220px; }
.stat {
  --stat-grad: var(--grad-primary);
  --shadow-tone: 51, 92, 129;   /* فولاذيّ 600 افتراضًا — يتبدّل مع النغمة */
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 18px 20px;
  border-radius: var(--radius);
  background: var(--surface-aurora);
  border: 1px solid var(--border-aurora);
  box-shadow: 0 4px 16px -2px rgba(var(--shadow-tone), .25);
  transition: border-color var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
}
.stat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.stat-ic {
  width: 44px; height: 44px; border-radius: var(--radius); flex: 0 0 auto;
  display: grid; place-items: center; color: #fff;
  background: var(--stat-grad);
  box-shadow: 0 8px 18px -8px rgba(var(--shadow-tone), .6);
  transition: transform .45s var(--ease-standard);   /* انسيابيّ بلا ارتداد */
}
.stat-ic svg { width: 23px; height: 23px; }
.stat-val { font-family: var(--font-latin); font-size: 32px; font-weight: 800; line-height: 1.05; letter-spacing: -.01em; color: var(--color-primary); }
.stat-label { font-size: 13px; font-weight: 600; color: var(--color-text-muted); margin-top: 4px; }
/* النغمة: تدرّج الأيقونة + سطح Aurora ملوّن + حدّ + ظلّ — بلون الحالة (كالكروت المنغّمة).
   نُعيد إعلان background/border-color على النغمة كي يُعاد حلّ var() لكلّ عنصر (لا يُخبَز). */
.stat-brand   { --stat-grad: var(--grad-primary); --shadow-tone: 51, 92, 129; --surface-aurora: linear-gradient(135deg, #e7ebf0, var(--color-surface) 62%); background: var(--surface-aurora); }
.stat-success { --stat-grad: var(--grad-success); --shadow-tone: 26, 132, 82;  --surface-aurora: linear-gradient(135deg, #e4f3ec, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--success-600) 30%, var(--color-border)); background: var(--surface-aurora); border-color: var(--border-aurora); }
.stat-warning { --stat-grad: var(--grad-warning); --shadow-tone: 184, 122, 12; --surface-aurora: linear-gradient(135deg, #faf2e2, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--warning-600) 32%, var(--color-border)); background: var(--surface-aurora); border-color: var(--border-aurora); }
.stat-danger  { --stat-grad: var(--grad-danger);  --shadow-tone: 181, 47, 34;  --surface-aurora: linear-gradient(135deg, #fae7e6, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--danger-600) 32%, var(--color-border)); background: var(--surface-aurora); border-color: var(--border-aurora); }
/* المرور: كِبَرٌ خفيف (scale 1.02) + تشديد الحدّ للنغمة — تمامًا كـ‎.mc:hover‎ في كرت العضو */
.stat:hover { transform: scale(var(--hover-scale)); }
.stat:hover .stat-ic { transform: scale(1.12) rotate(-6deg); }   /* نبضة زنبركيّة للأيقونة عند المرور */
.stat-brand:hover   { border-color: var(--navy-700); }
.stat-success:hover { border-color: var(--success-600); }
.stat-warning:hover { border-color: var(--warning-600); }
.stat-danger:hover  { border-color: var(--danger-600); }
@media (prefers-reduced-motion: reduce) { .stat:hover, .stat:hover .stat-ic { transform: none; } }


/* ============================================================
   حارس الهوية (Identity Guardrail)
   لا شيء يُنسَّق خارج نظام الهوية. الفجوات تُوسَم صراحةً فتظهر صارخة — تُصمَّم، لا تُنشَر.
   ============================================================ */

/* (١) علامة «يحتاج مكوّن هوية» — ضعها على أيّ شيء جديد بلا مكوّن جاهز:
   <div data-needs="اسم المكوّن">…</div>   ·   جرد النواقص كلّها: grep -r data-needs */
[data-needs]{
  position:relative; display:block;
  border:2px dashed var(--warning-600);
  border-radius:var(--radius);
  background:repeating-linear-gradient(45deg,
    transparent 0 12px,
    color-mix(in oklab, var(--warning-600) 8%, transparent) 12px 24px);
  padding:40px 20px 22px;
  color:var(--warning-800);
}
[data-needs]::before{
  content:"🚧 يحتاج مكوّن هوية: " attr(data-needs);
  position:absolute; inset-block-start:0; inset-inline-start:0;
  background:var(--grad-warning); color:#fff;
  font:700 12.5px/1.6 var(--font-body);
  padding:6px 13px;
  border-start-start-radius:var(--radius); border-end-end-radius:var(--radius);
}

/* (٢) كاشف العناصر الخام — يُفعَّل بوضع data-guardrail على أيّ سلف (نُفعّله في اللوحة وقت التطوير فقط).
   يوسم أيّ عنصر تفاعليّ/جدول لا يحمل صنف هوية بإطار صارخ حتى لا يمرّ صامتًا. */
[data-guardrail] :is(table,button,input,select,textarea):not([class]):not([data-needs] *){
  outline:3px dashed #e11d9c; outline-offset:3px;
}

/* ============================================================
   سلّم الزوايا — العناصر الصغيرة جدًّا (< 32px) → --radius-sm (8)
   عشان ما تنقلب دوائر/كبسولات. الأغلب يبقى --radius (16) من قواعده.
   المصدر الوحيد هنا (components.css يُحمَّل أخيرًا) — بلا !important.
   ============================================================ */
.av-xs, .ach-box, .pva-copy, .tx, .tic,
.dm-trigger, .mdl-x, .pag-arr, .pag-num, .mc-dots, .tb-view button {
  border-radius: var(--radius-sm);
}
