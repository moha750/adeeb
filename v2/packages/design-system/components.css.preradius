/* ============================================================
   @adeeb/design-system — components.css
   مكتبة مكوّنات أديب — المصدر الوحيد المشترك لأصناف المكوّنات (.abtn/.mdl/…).
   يستهلكها التطبيق (يشحنها) ومعرض /ui (يعرض المكوّنات الحقيقيّة الحيّة).
   تعتمد على رموز tokens.css — تُحمَّل بعده.
   ⚠️ عدّل المكوّنات هنا فقط؛ لا تكرّرها في globals.css.
   ============================================================ */

/* أصناف المكوّنات (تفوز على نسخ globals القديمة عبر ترتيب التحميل). */

/* ظهور الأقسام عند التمرير — بلا JS يبقى المحتوى ظاهرًا (تُفعّل فقط عند وجود .js) */
.js [data-reveal] {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  will-change: opacity, transform;
}
.js [data-reveal].is-visible {
  opacity: 1;
  transform: none;
}
@media (prefers-reduced-motion: reduce) {
  .js [data-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ============================================================
   معرض «إبداعاتنا» — جدار حيّ بأعمدة متعاكسة الاتجاه.
   العناصر مضاعفة مرّتين؛ الإزاحة -50% تعطي حلقة لا نهائية سلسة.
   ============================================================ */
@keyframes works-scroll {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-50%);
  }
}
.works-track {
  animation: works-scroll var(--dur, 36s) linear infinite;
  will-change: transform;
  backface-visibility: hidden;
}
.works-col:hover .works-track {
  animation-play-state: paused;
}
.works-wall-mask {
  -webkit-mask-image: linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
  mask-image: linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
}
@media (prefers-reduced-motion: reduce) {
  .works-track {
    animation: none;
  }
  .works-col {
    overflow-y: auto;
  }
}

/* ============================================================
   ملخص المسيرة — كروت بحجم الرقم (Treemap): مساحة الكرت ∝ قيمته،
   تملأ المستطيل بلا فراغ. تُبنى إحداثياتها بالـ JS (StatsTreemap).
   ============================================================ */
.tm-tile {
  position: absolute;
  opacity: 0;
  transform: scale(0.7);
  transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.34, 1.4, 0.5, 1);
}
.tm-in .tm-tile {
  opacity: 1;
  transform: none;
}
.tm-card {
  position: absolute;
  inset: 6px;
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
.tm-card.tm-hero {
  background: linear-gradient(150deg, var(--steel-600), #1d3049);
  border: 0;
  box-shadow: 0 24px 50px -26px rgba(0, 0, 0, 0.6);
}
.tm-card.tm-hero::after {
  content: "";
  position: absolute;
  inset-inline-start: -40px;
  top: -40px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15), transparent 70%);
}
.tm-ic {
  position: relative;
  width: 30px;
  height: 30px;
  color: #8fb2d6;
}
.tm-card.tm-hero .tm-ic {
  color: #cfe0f2;
  width: 42px;
  height: 42px;
}
.tm-ic svg {
  width: 100%;
  height: 100%;
}
.tm-badge {
  position: relative;
  align-self: flex-start;
  font-family: "Eras", sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #dcebf9;
  background: rgba(255, 255, 255, 0.18);
  padding: 3px 9px;
  border-radius: var(--radius-full);
  margin-bottom: 6px;
}
.tm-body {
  position: relative;
}
.tm-n {
  font-family: "Eras", sans-serif;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}
.tm-l {
  margin-top: 6px;
  font-size: 14px;
  color: #bcc9d9;
  font-weight: 700;
}
.tm-card.tm-hero .tm-l {
  font-size: 21px;
  color: #dbe6f2;
}
@media (prefers-reduced-motion: reduce) {
  .tm-tile {
    opacity: 1;
    transform: none;
  }
}

/* ============================================================
   أهل الدفّة (المجلس) — كاروسيل «تركيز المركز» ببطاقات كاملة الصورة
   وشريط زجاجيّ سفليّ. المقاييس تُحسب بالـ JS (BoardCarousel).
   ============================================================ */
.bc-stage {
  position: relative;
  height: 410px;
  overflow: hidden;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  /* تلاشٍ ناعم يمينًا ويسارًا بدل القصّ الحادّ */
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 10%, #000 90%, transparent 100%);
  mask-image: linear-gradient(to right, transparent 0, #000 10%, #000 90%, transparent 100%);
}
.bc-track {
  position: absolute;
  inset: 0;
}
/* أثناء السحب: أُعطّل الانتقال لتتبع البطاقات الإصبع فورًا (التحديث يدويّ) */
.bc-track.bc-dragging .bc-slide {
  transition: none;
}

/* ============================================================
   برامجنا وأنشطتنا — إطلالة جانبية (Peek) ببطاقات تسجيل (CTA).
   ============================================================ */
.act-peek {
  display: flex;
  gap: 22px;
  overflow-x: auto;
  padding: 6px 2px 22px;
  scrollbar-width: none;
  cursor: grab;
}
.act-peek::-webkit-scrollbar {
  display: none;
}
.act-peek:active {
  cursor: grabbing;
}
.act-card {
  /* ٣ بطاقات على الحاسب (فاصلان ×22px) */
  flex: 0 0 calc((100% - 44px) / 3);
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid #dde3ea;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 14px 30px -22px rgba(39, 64, 96, 0.5);
  transition: transform 0.3s, box-shadow 0.3s;
  text-decoration: none;
  color: inherit;
}
@media (max-width: 1023px) {
  /* بطاقتان */
  .act-card {
    flex-basis: calc((100% - 22px) / 2);
  }
}
@media (max-width: 639px) {
  /* بطاقة واحدة */
  .act-card {
    flex-basis: 100%;
  }
}
.act-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 28px 48px -26px rgba(39, 64, 96, 0.55);
}
.act-cov {
  position: relative;
  height: 176px;
  background: linear-gradient(150deg, #3a6595, #1d3049);
  background-size: cover;
  background-position: center;
}
.act-cov::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(15, 22, 33, 0.28), transparent 45%);
}
.act-date {
  position: absolute;
  top: 14px;
  inset-inline-start: 14px;
  z-index: 2;
  background: #fff;
  border-radius: var(--radius);
  padding: 8px 12px;
  text-align: center;
  line-height: 1;
  box-shadow: 0 10px 20px -8px rgba(39, 64, 96, 0.55);
}
.act-d {
  font-family: "Eras", sans-serif;
  font-size: 24px;
  font-weight: 700;
  color: var(--navy-700);
}
.act-m {
  font-size: 12px;
  color: var(--steel-600);
  font-weight: 700;
  margin-top: 3px;
}
.act-bd {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.act-title {
  font-weight: 800;
  color: var(--navy-700);
  font-size: 18px;
  line-height: 1.35;
  margin: 10px 0 0;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  /* سطر واحد ثابت لتوحيد ارتفاع البطاقات (الطويل يُقتطع بـ …) */
  min-height: 1.35em;
}
.act-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  color: #5a6675;
  font-size: 13px;
  margin-top: 10px;
}
.act-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.act-meta svg {
  width: 14px;
  height: 14px;
  color: var(--steel-600);
}
.act-ctrl {
  display: flex;
  align-items: center;
  gap: 12px;
}
.act-ctrl button {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1px solid #cfd7e0;
  background: #fff;
  color: var(--navy-700);
  font-size: 20px;
  cursor: pointer;
  transition: 0.2s;
  box-shadow: 0 8px 20px -12px rgba(39, 64, 96, 0.5);
}
.act-ctrl button:hover {
  background: var(--grad-primary);
  color: #fff;
}
@media (prefers-reduced-motion: reduce) {
  .act-card {
    transition: none;
  }
}

/* ============================================================
   آخر الأخبار — عرض تحريريّ متحرّك (مقال مميّز يتبدّل + قائمة/شريط).
   الطبقتان تُدارَان بالـ opacity عبر JS (لا className) لتفادي تصادم React.
   ============================================================ */
.ns-show {
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 26px;
  align-items: stretch;
}
.ns-feat {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  /* حدٌّ أدنى فقط؛ الارتفاع الفعليّ يتمدّد ليطابق ارتفاع القائمة (grid stretch) */
  min-height: 300px;
  background-color: #1d3049;
  background-image: var(--grad-primary-strong);
  box-shadow: 0 24px 50px -28px rgba(39, 64, 96, 0.6);
}
.ns-layer {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transition: opacity 0.9s ease;
}
@keyframes ns-kb {
  from { transform: scale(1.02); }
  to { transform: scale(1.12); }
}
.ns-grad {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to top, rgba(15, 22, 33, 0.94), rgba(15, 22, 33, 0.35) 55%, transparent 80%);
}
.ns-cap {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  padding: 30px;
  color: #fff;
  z-index: 2;
  animation: ns-fade 0.6s ease;
}
.ns-cap h3 {
  font-size: 25px;
  font-weight: 900;
  line-height: 1.4;
  margin: 4px 0 10px;
}
.ns-cap p {
  color: #d6e2f0;
  font-size: 14.5px;
}
@keyframes ns-fade {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}
.ns-prog {
  position: absolute;
  top: 0;
  inset-inline: 0;
  height: 4px;
  z-index: 3;
  background: rgba(255, 255, 255, 0.22);
}
.ns-prog > i {
  display: block;
  height: 100%;
  width: 0;
  background: #fff;
}
.ns-prog > i.ns-run {
  animation: ns-fill 5s linear forwards;
}
@keyframes ns-fill {
  from { width: 0; }
  to { width: 100%; }
}
.ns-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  color: #cfe0f2;
  font-size: 12.5px;
  align-items: center;
}
.ns-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.ns-meta svg {
  width: 13px;
  height: 13px;
}
.ns-clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ns-clamp3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ns-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  /* الارتفاع الطبيعيّ للقائمة هو من يحدّد ارتفاع الصفّ (والبطل يطابقه) — بلا تمرير ولا فجوات */
}
.ns-li {
  display: grid;
  grid-template-columns: 92px 1fr;
  gap: 12px;
  padding: 8px;
  border-radius: var(--radius);
  cursor: pointer;
  transition: 0.25s;
  border: 1px solid transparent;
  background: transparent;
  text-align: start;
  font: inherit;
  color: inherit;
}
.ns-li:hover {
  background: #fff;
}
.ns-li.ns-on {
  background: #fff;
  border-color: #dde3ea;
  box-shadow: 0 12px 26px -20px rgba(39, 64, 96, 0.5);
}
.ns-th {
  height: 64px;
  border-radius: var(--radius);
  background-size: cover;
  background-position: center;
  background-color: #1d3049;
  background-image: var(--grad-primary-strong);
}
.ns-st {
  align-self: center;
  min-width: 0;
}
.ns-h4 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 14px;
  font-weight: 800;
  color: #5a6675;
  line-height: 1.4;
  margin-bottom: 4px;
}
.ns-li.ns-on .ns-h4 {
  color: var(--navy-700);
}
.ns-lidate {
  font-size: 12px;
  color: #7a8594;
}
.ns-rail {
  display: none;
  gap: 12px;
  overflow-x: auto;
  padding: 14px 2px 4px;
  scrollbar-width: none;
  cursor: grab;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
}
.ns-rail:active {
  cursor: grabbing;
}
.ns-rail::-webkit-scrollbar {
  display: none;
}
/* تلاشي الحافّتين — يُفعّل بالـJS فقط حين يفيض الشريط (وجود مزيد للسحب) */
.ns-rail.ns-rail-fade {
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
  mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
}
.ns-rt {
  /* تتمدّد لتملأ العرض بالتساوي (لا فراغ)؛ وتتمرّر أفقيًّا فقط على الشاشات الضيّقة جدًّا */
  flex: 1 0 108px;
  min-width: 0;
  height: 78px;
  border-radius: var(--radius);
  background-size: cover;
  background-position: center;
  background-color: #1d3049;
  background-image: var(--grad-primary-strong);
  position: relative;
  cursor: pointer;
  overflow: hidden;
  outline: 3px solid transparent;
  outline-offset: -3px;
  transition: 0.25s;
  border: 0;
  padding: 0;
}
.ns-rt::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(15, 22, 33, 0.45);
  transition: 0.25s;
}
.ns-rt.ns-on {
  outline-color: var(--navy-700);
}
.ns-rt.ns-on::after {
  background: rgba(15, 22, 33, 0.05);
}
@media (max-width: 860px) {
  .ns-show {
    grid-template-columns: 1fr;
  }
  .ns-list {
    display: none;
  }
  .ns-rail {
    display: flex;
  }
  .ns-feat {
    min-height: 360px;
  }
  .ns-cap h3 {
    font-size: 21px;
  }
}
/* طبقة عمق تُبعد البطاقات الجانبية بلون الخلفية (بلا شفافية تُظهر ما خلفها) */
.bc-dim {
  position: absolute;
  inset: 0;
  background: #eef2f7;
  pointer-events: none;
  transition: opacity 0.5s ease;
}
.bc-slide {
  position: absolute;
  top: 11px;
  left: 50%;
  transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.55s ease;
  will-change: transform, opacity;
  cursor: pointer;
}
.bc-card {
  position: relative;
  width: 290px;
  aspect-ratio: 3 / 4;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 26px 50px -26px rgba(39, 64, 96, 0.65);
  background: linear-gradient(150deg, #3a6595, #1d3049);
}
.bc-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
}
.bc-mono {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Lyon Arabic", serif;
  font-weight: 700;
  font-size: 104px;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 0.04em;
}
.bc-grad {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(15, 22, 33, 0.55), transparent 55%);
}
.bc-info {
  position: absolute;
  inset-inline: 12px;
  bottom: 12px;
  padding: 14px 16px;
  border-radius: var(--radius);
  background: rgba(18, 30, 46, 0.5);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.bc-nm {
  font-size: 16px;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}
.bc-rl {
  font-size: 12px;
  color: #cfe0f2;
  font-weight: 700;
}
.bc-socs {
  display: flex;
  gap: 8px;
}
.bc-socs a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  transition: 0.2s;
  flex: 0 0 auto;
}
.bc-socs a:hover {
  background: #fff;
  color: var(--navy-700);
}
.bc-arrows {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 8px;
}
.bc-arrows button {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid #cfd7e0;
  background: #fff;
  color: var(--navy-700);
  font-size: 20px;
  cursor: pointer;
  transition: 0.2s;
  box-shadow: 0 8px 20px -12px rgba(39, 64, 96, 0.5);
}
.bc-arrows button:hover {
  background: var(--grad-primary);
  color: #fff;
}
@media (prefers-reduced-motion: reduce) {
  .bc-slide {
    transition: none;
  }
}

/* ============================================================
   الزرّ الأساسي المعتمد (بُني خطوة‑خطوة): تدرّج كحليّ · زوايا 16px ·
   ظلّ ناعم · (تكبير خفيف + كنس ضوئيّ عند المرور) · أيقونة قبل النصّ.
   ============================================================ */
.abtn {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: "Lyon Arabic", sans-serif;
  font-weight: 700;
  border-radius: var(--radius);
  border: 1px solid transparent;
  line-height: 1;
  cursor: pointer;
  white-space: nowrap;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease,
    border-color 0.2s ease, color 0.2s ease, filter 0.2s ease;
}
.abtn::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 100%;
  inset-inline-start: -120%;
  /* شعاع عريض بمسطّح مضيء + انزلاقة أبطأ */
  background: linear-gradient(115deg, transparent 8%, rgba(255, 255, 255, 0.2) 32%, rgba(255, 255, 255, 0.2) 68%, transparent 92%);
  transform: skewX(-16deg);
  transition: inset-inline-start 1s ease;
  pointer-events: none;
}
.abtn:hover:not(:disabled) {
  transform: scale(1.045);
}
.abtn:hover:not(:disabled)::after {
  inset-inline-start: 200%;
}
.abtn:focus-visible {
  outline: 2px solid var(--steel-500);
  outline-offset: 2px;
}
.abtn:disabled {
  opacity: 0.55;
  pointer-events: none;
}
/* حالة التحميل: غير تفاعليّة كالمعطّل (تمنع الإرسال المزدوج) لكنها تحتفظ بلون
   الهوية كاملًا — «الإجراء يعمل الآن» رسالة مختلفة عن «مُعطّل/غير متاح».
   pointer-events:none يوقف النقر والمرور (فلا تكبير ولا شعاع)، وaria-busy يعلن الحالة. */
.abtn[aria-busy="true"] {
  pointer-events: none;
  opacity: 1;
}
.abtn svg {
  width: 1.05em;
  height: 1.05em;
  flex: 0 0 auto;
}
.abtn-spin {
  width: 1em;
  height: 1em;
  /* المسار باهت شفّاف، والرأس صلب يسبق الدوران */
  border: 2px solid color-mix(in oklab, currentColor 26%, transparent);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: abtn-spin 0.7s linear infinite;
  flex: 0 0 auto;
}
@keyframes abtn-spin {
  to { transform: rotate(360deg); }
}
/* الأحجام */
.abtn-sm { padding: 8px 15px; font-size: 14px; }
.abtn-md { padding: 11px 22px; font-size: 15px; }
.abtn-lg { padding: 14px 28px; font-size: 17px; }
/* الأنماط */
.abtn-primary { background: var(--grad-primary); color: #fff; box-shadow: 0 10px 26px -8px rgba(51, 92, 129, 0.5); }
.abtn-primary:hover:not(:disabled) { background: var(--grad-primary-hover); box-shadow: 0 16px 34px -8px rgba(51, 92, 129, 0.6); }
.abtn-danger { background: var(--grad-danger); color: #fff; box-shadow: 0 4px 12px -4px rgba(210, 59, 44, 0.4); }
.abtn-danger:hover:not(:disabled) { filter: brightness(0.95); }
.abtn-success { background: var(--grad-success); color: #fff; box-shadow: 0 4px 12px -4px rgba(31, 157, 95, 0.4); }
.abtn-success:hover:not(:disabled) { filter: brightness(0.96); }
.abtn-warning { background: var(--grad-warning); color: #fff; box-shadow: 0 4px 12px -4px rgba(217, 146, 15, 0.4); }
.abtn-warning:hover:not(:disabled) { filter: brightness(0.96); }
/* الشبحيّ المحايد — كحليّ في الفاتح، أبيض في الداكن (كـ«معكوس شبحيّ») عبر رمز ينقلب مع الثيم */
.abtn-ghost { background: transparent; border-color: var(--btn-ghost-border); color: var(--btn-ghost-fg); }
.abtn-ghost:hover:not(:disabled) { background: color-mix(in oklab, var(--btn-ghost-fg) 9%, transparent); border-color: color-mix(in oklab, var(--btn-ghost-fg) 72%, transparent); }
.abtn-ghost::after { display: none; }
/* شبحيّ دلاليّ — مفرّغ بلون النغمة (حدّ ناعم + نصّ)، لملء ثانويّ يطابق النغمة */
.abtn-ghost-danger, .abtn-ghost-success, .abtn-ghost-warning { background: transparent; }
.abtn-ghost-danger::after, .abtn-ghost-success::after, .abtn-ghost-warning::after { display: none; }
.abtn-ghost-danger { border-color: color-mix(in oklab, var(--danger-500) 42%, transparent); color: var(--danger-500); }
.abtn-ghost-danger:hover:not(:disabled) { background: color-mix(in oklab, var(--danger-500) 10%, transparent); border-color: var(--danger-500); }
.abtn-ghost-success { border-color: color-mix(in oklab, var(--success-500) 42%, transparent); color: color-mix(in oklab, var(--success-500), #000 12%); }
.abtn-ghost-success:hover:not(:disabled) { background: color-mix(in oklab, var(--success-500) 10%, transparent); border-color: var(--success-500); }
.abtn-ghost-warning { border-color: color-mix(in oklab, var(--warning-500) 46%, transparent); color: color-mix(in oklab, var(--warning-500), #000 20%); }
.abtn-ghost-warning:hover:not(:disabled) { background: color-mix(in oklab, var(--warning-500) 14%, transparent); border-color: var(--warning-500); }
/* الشبحيّ: حدّ أسمك (stroke) */
.abtn-ghost, .abtn-ghost-danger, .abtn-ghost-success, .abtn-ghost-warning, .abtn-inverse-ghost { border-width: 2px; }
.abtn-inverse { background: #fff; color: var(--navy-700); box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.25); }
.abtn-inverse:hover:not(:disabled) { background: var(--navy-50); }
.abtn-inverse::after { display: none; }
/* لا يوجد «معكوس دلاليّ» — الأزرار الدلاليّة الصارخة (خطر/تحذير/نجاح) تُقرأ على السطح
   الداكن كما هي، فلا نسخة معكوسة لها. يُعكَس فقط ما يختفي على الداكن: الأساسيّ والشبحيّ. */
/* شبحيّ معكوس — مفرّغ بحدّ ونصّ فاتحين، يُقرأ على السطح الداكن */
.abtn-inverse-ghost { background: transparent; border-color: rgba(255, 255, 255, 0.5); color: #fff; box-shadow: none; }
.abtn-inverse-ghost:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.85); }
.abtn-inverse-ghost::after { display: none; }
@media (prefers-reduced-motion: reduce) {
  .abtn:hover:not(:disabled) { transform: none; }
  .abtn::after { display: none; }
}

/* ============================================================
   نظام الحقل المعتمَد (منقول حرفيًّا من لوح الهوية): تسمية ثابتة أعلى + أيقونة الهوية بجانبها ·
   سطح مسطّح · تركيز فولاذيّ · استدارة 16 · حالات الخطأ/النجاح بلون الدلالة 600.
   ============================================================ */
.fld { display: flex; flex-direction: column; gap: 8px; }
.fld-lbl { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; padding-inline-start: 2px; }
.fld-lic { width: 18px; height: 18px; color: var(--steel-600); flex: 0 0 auto; display: inline-flex; transition: color var(--dur); }
.fld-lic svg { width: 100%; height: 100%; }
.fld-wrap { position: relative; display: flex; align-items: center; }
.fld-in { width: 100%; height: 48px; padding: 0 16px; border-radius: var(--radius); background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); transition: border-color var(--dur), box-shadow var(--dur); }
.fld-in::placeholder { color: var(--color-text-muted); }
.fld-in:focus { outline: 0; border-color: var(--steel-600); box-shadow: 0 0 0 3px rgba(51,92,129,.16); }
.fld-in:disabled { background: var(--color-surface-2); color: var(--color-text-muted); cursor: not-allowed; }
.fld-area { height: auto; min-height: 96px; padding: 12px 16px; line-height: 1.6; resize: vertical; }
.fld-help { font-size: 12px; color: var(--color-text-muted); padding-inline-start: 3px; }
.fld.err .fld-lbl, .fld.err .fld-lic, .fld.err .fld-help { color: var(--danger-600); }
.fld.err .fld-in { border-color: var(--danger-600); box-shadow: 0 0 0 3px rgba(181,47,34,.16); }
.fld.ok .fld-lbl, .fld.ok .fld-lic { color: var(--success-600); }
.fld.ok .fld-in { border-color: var(--success-600); box-shadow: 0 0 0 3px rgba(26,132,82,.16); }
/* القائمة المنسدلة (Select) تتبع نظام الحقل: تسمية ثابتة أعلى · مسطّح · حلقة تركيز */
.fld .asel-label { display: none; }
.fld .asel-trigger { height: 48px; padding: 0 44px 0 16px; display: flex; align-items: center; border-radius: var(--radius); background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: none; }
.fld .asel-trigger:focus-visible, .fld .asel-open .asel-trigger { border-color: var(--steel-600); box-shadow: 0 0 0 3px rgba(51,92,129,.16); }

/* ============================================================
   القائمة المنسدلة المعتمدة (بُنيت خطوة‑خطوة): زناد بهوية الحقل ·
   سهم في دائرة يدور · لوحة بحدّ بارز · مرور فاتح · مُختار كحليّ + صحّ ·
   بحث + تجميع + أيقونات. مكوّن Select تفاعليّ.
   ============================================================ */
.asel { position: relative; display: block; }
.asel-trigger {
  position: relative;
  width: 100%;
  text-align: start;
  padding: 19px 44px 7px 14px;
  border-radius: var(--radius);
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  box-shadow: inset 0 2px 4px rgba(24, 32, 49, 0.07);
  color: var(--color-text);
  cursor: pointer;
  font: inherit;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}
.asel-trigger:focus-visible,
.asel-open .asel-trigger {
  outline: none;
  border-color: var(--steel-600);
  box-shadow: inset 0 2px 4px rgba(24, 32, 49, 0.05), 0 0 0 3px rgba(51, 92, 129, 0.16), 0 10px 26px -12px rgba(51, 92, 129, 0.5);
}
.asel-value { display: block; min-height: 1.5em; }
.asel-label {
  position: absolute;
  inset-inline-start: 15px;
  top: 14px;
  color: var(--color-text-muted);
  pointer-events: none;
  transition: top 0.16s ease, font-size 0.16s ease, color 0.16s ease;
}
.asel-filled .asel-label,
.asel-open .asel-label { top: 7px; font-size: 11px; font-weight: 700; color: var(--steel-600); }
.asel-chev {
  position: absolute;
  inset-inline-end: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 26px;
  height: 26px;
  background: var(--color-surface-2);
  color: var(--color-text-muted);
  border-radius: 50%;
  display: grid;
  place-items: center;
  transition: background 0.2s ease, color 0.2s ease;
}
.asel-chev svg { width: 16px; height: 16px; transition: transform 0.2s ease; }
.asel-open .asel-chev { background: var(--grad-primary); color: #fff; }
.asel-open .asel-chev svg { transform: rotate(180deg); }
.asel-panel {
  position: absolute;
  z-index: 40;
  top: calc(100% + 6px);
  inset-inline: 0;
  padding: 6px;
  background: var(--color-surface);
  border: 1.5px solid #d5dde7;
  border-radius: var(--radius);
  box-shadow: 0 18px 42px -16px rgba(51, 92, 129, 0.45);
  max-height: 288px;
  overflow: auto;
  animation: asel-in 0.14s ease;
}
@keyframes asel-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
.asel-search { position: relative; margin: 2px 2px 6px; }
.asel-search input {
  width: 100%;
  padding: 9px 12px;
  padding-inline-start: 34px;
  border-radius: var(--radius);
  border: 1px solid var(--color-border);
  background: var(--color-surface-2);
  font: inherit;
  color: var(--color-text);
  outline: none;
}
.asel-search input:focus { border-color: var(--steel-600); }
.asel-search .asel-si { position: absolute; inset-inline-start: 10px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--color-text-muted); }
.asel-gh { padding: 8px 12px 4px; font-size: 11.5px; font-weight: 700; color: var(--color-text-muted); }
.asel-opt {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: var(--radius);
  font-size: 14.5px;
  color: var(--color-text);
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.asel-opt.asel-hl { background: #f4f6f9; }
.asel-opt .asel-txt { flex: 1; }
.asel-opt .asel-oic { width: 17px; height: 17px; color: var(--color-text-muted); flex: 0 0 auto; }
.asel-opt .asel-oic svg,
.asel-opt .asel-ck svg { width: 100%; height: 100%; }
.asel-opt .asel-ck { width: 16px; height: 16px; color: var(--navy-700); flex: 0 0 auto; visibility: hidden; }
.asel-opt.asel-sel { background: #eef2f7; }
.asel-opt.asel-sel .asel-txt { font-weight: 700; color: var(--navy-700); }
.asel-opt.asel-sel .asel-oic { color: var(--navy-700); }
.asel-opt.asel-sel .asel-ck { visibility: visible; }
.asel-empty { padding: 12px; text-align: center; color: var(--color-text-muted); font-size: 13.5px; }
.asel-help { display: block; margin-top: 6px; font-size: 12.5px; color: var(--color-text-muted); }
/* حالة الخطأ */
.asel-error .asel-trigger,
.asel-error.asel-open .asel-trigger {
  border-color: var(--color-border);
  box-shadow: inset 0 2px 4px rgba(24, 32, 49, 0.05), 0 0 0 3px rgba(192, 57, 43, 0.2);
}
.asel-error .asel-label,
.asel-error.asel-filled .asel-label { color: #c0392b; }
.asel-error .asel-help { color: #c0392b; }
/* تعطيل */
.asel-disabled .asel-trigger { background: var(--color-surface-2); color: var(--color-text-muted); cursor: not-allowed; }
@media (prefers-reduced-motion: reduce) {
  .asel-panel { animation: none; }
  .asel-chev, .asel-chev svg, .asel-label, .asel-trigger { transition: none; }
}

/* ============================================================
   عناصر الاختيار (بُنيت خطوة‑خطوة): تحديد بتدرّج لوني الهوية ·
   مفتاح كلاسيكيّ · حركة (رسم العلامة + ارتداد زنبركيّ) · كل التخطيطات.
   الحالة تُقرأ عبر :has(input:checked) لتعمل مهما كان تداخل التخطيط.
   ============================================================ */
.ach { display: inline-flex; align-items: center; gap: 12px; cursor: pointer; }
.ach--block { display: flex; width: 100%; }
.ach.is-disabled { opacity: 0.5; pointer-events: none; }
.ach input { position: absolute; opacity: 0; width: 0; height: 0; }
.ach-box, .ach-radio {
  width: 22px; height: 22px; flex: 0 0 auto;
  border: 2px solid var(--navy-200); background: #fff;
  display: grid; place-items: center;
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}
.ach-box { border-radius: var(--radius); }
.ach-radio { border-radius: 50%; }
.ach:has(input:checked) .ach-box,
.ach:has(input:checked) .ach-radio { background: var(--grad-primary); border-color: var(--navy-700); }
.ach-chk {
  width: 14px; height: 14px; color: #fff; opacity: 0; transform: scale(0.3);
  transition: opacity 0.16s ease, transform 0.5s cubic-bezier(0.2, 1.9, 0.35, 1);
}
.ach-chk path { stroke-dasharray: 26; stroke-dashoffset: 26; transition: stroke-dashoffset 0.32s ease; }
.ach:has(input:checked) .ach-chk { opacity: 1; transform: scale(1); }
.ach:has(input:checked) .ach-chk path { stroke-dashoffset: 0; }
.ach-dot { width: 9px; height: 9px; border-radius: 50%; background: #fff; transform: scale(0); transition: transform 0.4s cubic-bezier(0.2, 1.9, 0.35, 1); }
.ach:has(input:checked) .ach-dot { transform: scale(1); }
/* المفتاح */
.ach-sw { width: 46px; height: 26px; flex: 0 0 auto; border-radius: var(--radius-full); background: var(--navy-200); position: relative; transition: background 0.2s ease; }
.ach-kn { position: absolute; top: 3px; inset-inline-start: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25); transition: inset-inline-start 0.5s cubic-bezier(0.2, 1.9, 0.35, 1); }
.ach:has(input:checked) .ach-sw { background: var(--grad-primary); }
.ach:has(input:checked) .ach-kn { inset-inline-start: 23px; }
/* حلقة تركيز لوحة المفاتيح */
.ach:has(input:focus-visible) .ach-box,
.ach:has(input:focus-visible) .ach-radio,
.ach:has(input:focus-visible) .ach-sw { box-shadow: 0 0 0 3px rgba(51, 92, 129, 0.28); }
/* النصّ */
.ach-lbl { font-size: 15px; }
.ach-txt { display: flex; flex-direction: column; line-height: 1.35; }
.ach-txt b { font-weight: 700; }
.ach-txt small { color: var(--color-text-muted); font-size: 12.5px; }
/* صفّ إعدادات */
.ach-rowbetween { justify-content: space-between; }
.ach-rowbetween .ach-txt, .ach-rowbetween .ach-lbl { flex: 1; }
/* بطاقة قابلة للاختيار */
.ach-card { display: flex; align-items: center; gap: 12px; width: 100%; border: 1.5px solid var(--color-border); border-radius: var(--radius); padding: 14px 16px; background: var(--color-surface); transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease; }
.ach-card .ach-txt, .ach-card .ach-lbl { flex: 1; }
.ach:has(input:checked) .ach-card { border-color: var(--navy-700); background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 9%, var(--color-surface)), var(--color-surface) 70%); box-shadow: 0 12px 26px -14px rgba(51, 92, 129, 0.5); }
.ach-cic { width: 20px; height: 20px; color: var(--color-text-muted); flex: 0 0 auto; }
.ach:has(input:checked) .ach-cic { color: var(--navy-700); }
@media (prefers-reduced-motion: reduce) {
  .ach-chk, .ach-dot, .ach-kn { transition: none; }
  .ach-chk path { transition: none; stroke-dashoffset: 0; }
}

/* ============================================================
   الشارات (بُنيت خطوة‑خطوة): ناعم + نقطة · حبّة متوسط · مؤشّرات
   (نقطة/أيقونة/live/إزالة) · ألوان دلالية حيّة. لون النغمة عبر متغيّر.
   ============================================================ */
.abadge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
  border: 1px solid transparent;
}
/* النغمات — تضبط لون النصّ والخلفية */
/* محايد = رماديّ حقيقيّ (ليس لون هوية) — كي لا يظهر أزرقان منفصلان؛ الأزرق نغمة «معلومة» وحدها بالتدرّج */
.abadge-neutral { --bc: var(--neutral-600); --bbg: var(--neutral-100); }
.abadge-info { --bc: var(--steel-600); --bbg: var(--steel-50); --bgrad: var(--grad-primary); }
.abadge-success { --bc: var(--success-500); --bbg: #e2f6ec; }
.abadge-warning { --bc: var(--warning-500); --bbg: #fcf1d8; }
.abadge-danger { --bc: var(--danger-500); --bbg: #fbe6e3; }
/* الأنماط */
.abadge-soft { background: linear-gradient(135deg, var(--bbg), color-mix(in oklab, var(--bc) 4%, #fff)); color: var(--bc); }
/* صلب = تعبئة متدرّجة زاويًّا من درجة النغمة (--bgrad)، لا لونًا صلبًا.
   الافتراضيّ تدرّج من الدرجة نفسها؛ النغمتان المحايدة/المعلومة (لونا الهوية) تُبدَّلان لتدرّج الزوج. */
.abadge-solid { background: var(--bgrad, linear-gradient(135deg, color-mix(in oklab, var(--bc), #fff 13%), color-mix(in oklab, var(--bc), #000 15%))); color: #fff; }
.abadge-outline { background: transparent; border-color: var(--bc); color: var(--bc); }
/* زجاجيّة — تُقرأ فوق الصور والخلفيات الداكنة (نصّ فاتح + ضباب) */
.abadge-glass { background: var(--glass-bg); color: #fff; border-color: var(--glass-border); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
/* الأحجام */
.abadge-sm { padding: 3px 9px; font-size: 11.5px; border-radius: var(--radius-full); }
.abadge-md { padding: 4px 11px; font-size: 12.5px; border-radius: var(--radius-full); }
.abadge-lg { padding: 6px 14px; font-size: 14px; border-radius: var(--radius-full); }
/* المؤشّرات */
.abadge-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
.abadge-ic { width: 14px; height: 14px; flex: 0 0 auto; display: inline-flex; }
.abadge-ic svg { width: 100%; height: 100%; }
.abadge-live { position: relative; width: 8px; height: 8px; flex: 0 0 auto; }
.abadge-live i { position: absolute; inset: 0; border-radius: 50%; background: currentColor; }
.abadge-live::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: currentColor; animation: abadge-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite; }
@keyframes abadge-ping { 0% { transform: scale(1); opacity: 0.55; } 100% { transform: scale(2.6); opacity: 0; } }
.abadge-rm { display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; border: 0; cursor: pointer; color: inherit; margin-inline-start: 2px; background: color-mix(in oklab, var(--bc) 14%, transparent); transition: background 0.15s ease; }
.abadge-rm svg { width: 11px; height: 11px; }
.abadge-rm:hover { background: color-mix(in oklab, var(--bc) 26%, transparent); }
.abadge-solid .abadge-rm { background: rgba(255, 255, 255, 0.25); }
.abadge-solid .abadge-rm:hover { background: rgba(255, 255, 255, 0.4); }
/* شارة عدّ دائرية */
.acount {
  display: inline-grid;
  place-items: center;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: var(--radius-full);
  font-family: "Eras", sans-serif;
  font-feature-settings: "tnum";
  font-size: 12px;
  font-weight: 700;
  background: var(--bgrad, linear-gradient(135deg, color-mix(in oklab, var(--bc), #fff 13%), color-mix(in oklab, var(--bc), #000 15%)));
  color: #fff;
}
.acount-neutral { --bc: var(--neutral-600); }
.acount-info { --bc: var(--steel-600); --bgrad: var(--grad-primary); }
.acount-success { --bc: var(--success-500); }
.acount-warning { --bc: var(--warning-500); }
.acount-danger { --bc: var(--danger-500); }
@media (prefers-reduced-motion: reduce) {
  .abadge-live::after { animation: none; }
}

/* ============================================================
   البطاقات (بُنيت خطوة‑خطوة): حدّ + ظلّ ناعم · مرور (تكبير + حدّ ملوّن)
   عبر interactive · تركيب Media/Body/Footer/Header + أفقية · أنماط.
   ============================================================ */
.acard {
  /* Aurora / Soft-Gradient: سطح متدرّج ناعم + ظلّ فولاذيّ */
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 12%, var(--color-surface)), var(--color-surface) 62%);
  border: 1px solid color-mix(in oklab, var(--steel-600) 10%, var(--color-border));
  border-radius: var(--radius);
  box-shadow: 0 16px 36px -20px rgba(51, 92, 129, 0.42);
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}
.acard-interactive { cursor: pointer; }
.acard-interactive:hover {
  transform: scale(var(--hover-scale));
  border-color: var(--navy-700);
  box-shadow: 0 24px 46px -24px rgba(51, 92, 129, 0.5);
}
/* المرتفعة تُستعمَل غالبًا بصورة تغطّي الأعلى، فيُخفى وهج Aurora العلويّ ويقع الجسم في منطقة التلاشي.
   نُنزل الوهج إلى الأسفل (0deg) ليظهر في الجسم تحت الصورة. */
.acard-elevated { box-shadow: 0 28px 55px -28px rgba(51, 92, 129, 0.5); --surface-aurora: linear-gradient(0deg, color-mix(in oklab, var(--steel-600) 14%, var(--color-surface)), var(--color-surface) 66%); background: var(--surface-aurora); }
.acard-horizontal { display: grid; grid-template-columns: 150px 1fr; }
.acard-media {
  display: block;
  width: 100%;
  height: 176px;
  background-size: cover;
  background-position: center;
  background-color: #1d3049;
  background-image: var(--grad-primary-strong);
}
.acard-horizontal .acard-media { height: 100%; }
.acard-body { padding: 20px; }
.acard-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 20px;
  border-top: 1px solid var(--color-border);
  background: var(--color-surface-2);
}
.acard-header { display: flex; align-items: center; gap: 12px; padding: 20px 20px 0; }
.acard-chip {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: var(--radius);
  background: var(--grad-primary);
  color: #fff;
  display: grid;
  place-items: center;
}
.acard-chip svg { width: 22px; height: 22px; }
.acard-htitle { font-size: 17px; font-weight: 800; color: var(--color-text); margin: 0; }
.acard-hsub { color: var(--color-text-muted); font-size: 12.5px; }
@media (prefers-reduced-motion: reduce) {
  .acard { transition: none; }
  .acard-interactive:hover { transform: none; }
}

/* بطاقة عامّة منغّمة — سطح Aurora + حدّ + ظلّ + قرص الرأس بلون الحالة (كطبقة نغمة الجدول وكرت العضو).
   يكفي ضبط الرموز؛ يقرؤها أساسُ ‎.acard‎ فيتلوّن السطح والحدّ والظلّ. والنصّ يبقى محايدًا لمقروئيّة المحتوى. */
.acard-tone-brand   { --shadow-tone: 51, 92, 129;  --surface-aurora: linear-gradient(135deg, #e7ebf0, var(--color-surface) 62%); background: var(--surface-aurora); }
.acard-tone-success { --shadow-tone: 26, 132, 82;  --surface-aurora: linear-gradient(135deg, #e4f3ec, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--success-600) 30%, var(--color-border)); background: var(--surface-aurora); border-color: var(--border-aurora); }
.acard-tone-warning { --shadow-tone: 184, 122, 12; --surface-aurora: linear-gradient(135deg, #faf2e2, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--warning-600) 32%, var(--color-border)); background: var(--surface-aurora); border-color: var(--border-aurora); }
.acard-tone-danger  { --shadow-tone: 181, 47, 34;  --surface-aurora: linear-gradient(135deg, #fae7e6, var(--color-surface) 62%); --border-aurora: color-mix(in oklab, var(--danger-600) 32%, var(--color-border)); background: var(--surface-aurora); border-color: var(--border-aurora); }
.acard-tone-success .acard-chip { background: var(--grad-success); }
.acard-tone-warning .acard-chip { background: var(--grad-warning); }
.acard-tone-danger  .acard-chip { background: var(--grad-danger); }

/* ============================================================
   التنبيهات (بُنيت خطوة‑خطوة): أسلوب Aurora / تدرّج ناعم + ظلّ ملوّن ·
   أيقونة/عنوان/رسالة/إغلاق/إجراءات · ألوان دلالية حيّة (لون النغمة عبر --ac).
   ============================================================ */
.aalert {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 15px 16px;
  border-radius: var(--radius);
  background: linear-gradient(
    125deg,
    color-mix(in oklab, var(--ac) 16%, var(--color-surface)),
    color-mix(in oklab, var(--ac) 5%, var(--color-surface)) 60%,
    var(--color-surface)
  );
  border: 1px solid color-mix(in oklab, var(--ac) 22%, transparent);
  box-shadow: 0 14px 30px -16px color-mix(in oklab, var(--ac) 55%, transparent);
}
.aalert-compact { align-items: center; }
.aalert-tone-neutral { --ac: var(--neutral-600); --agrad: linear-gradient(135deg, var(--neutral-400), var(--neutral-600)); }
.aalert-tone-info { --ac: var(--steel-600); --agrad: var(--grad-primary); }
.aalert-tone-success { --ac: var(--success-500); --agrad: var(--grad-success); }
.aalert-tone-warning { --ac: var(--warning-500); --agrad: var(--grad-warning); }
.aalert-tone-danger { --ac: var(--danger-500); --agrad: var(--grad-danger); }
.aalert-ic {
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  border-radius: var(--radius);
  display: grid;
  place-items: center;
  /* خلفية مصمتة بتدرّج النغمة + رمز أبيض + توهّج — كأيقونة Toast (وباقي التنبيه على أصله) */
  color: #fff;
  background: var(--agrad);
  box-shadow: 0 6px 14px -6px color-mix(in oklab, var(--ac) 70%, transparent);
}
.aalert-ic svg { width: 20px; height: 20px; }
.aalert-compact .aalert-ic { width: 30px; height: 30px; }
.aalert-compact .aalert-ic svg { width: 17px; height: 17px; }
.aalert-bd { flex: 1; min-width: 0; }
.aalert-title { font-weight: 800; color: var(--ac); margin-bottom: 2px; }
.aalert-msg { font-size: 13.5px; color: var(--color-text); }
.aalert-close {
  flex: 0 0 auto;
  align-self: center;                 /* عموديًّا في منتصف التنبيه */
  width: 28px;
  height: 28px;
  border-radius: var(--radius);       /* دائريّ عند 28px كزرّ إغلاق التوست */
  border: 0;
  /* خلفيّة نغمة خفيفة ظاهرة (كزرّ إغلاق التوست) تغمق عند المرور */
  background: color-mix(in oklab, var(--ac) 10%, transparent);
  color: var(--ac);
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: background 0.15s ease;
}
.aalert-close:hover { background: color-mix(in oklab, var(--ac) 16%, transparent); }
.aalert-close svg { width: 15px; height: 15px; }
.aalert-actions { display: flex; gap: 10px; margin-top: 12px; }
/* أزرار عاديّة فقط — تُستثنى أزرار نظام التصميم (.abtn) كي لا تصطدم التنسيقات */
.aalert-actions button:not(.abtn) {
  font-family: "Lyon Arabic", sans-serif;
  font-weight: 800;
  font-size: 13px;
  padding: 7px 13px;
  border-radius: var(--radius);
  border: 0;
  cursor: pointer;
  background: var(--agrad, linear-gradient(135deg, color-mix(in oklab, var(--ac), #fff 13%), color-mix(in oklab, var(--ac), #000 15%)));
  color: #fff;
}
.aalert-actions button:not(.abtn).ghost { background: transparent; color: var(--ac); }
.aalert-actions button:not(.abtn).ghost:hover { background: color-mix(in oklab, var(--ac) 10%, transparent); }
/* الزرّ الأساسي — مطبَّق */

/* fields applied */

/* selects applied */

/* choice applied */

/* badges applied */

/* cards applied */

/* alerts applied */

/* card aurora applied */

