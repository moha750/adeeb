/* members status tabs */
.members-tabs { margin-bottom: 16px; overflow-x: auto; }

/* ============================================================
   مبدّل العرض (جدول/كروت) في الشريط · .tb-view
   ============================================================ */
.tb-view { display: inline-flex; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 3px; gap: 2px; }
.tb-view button { width: 34px; height: 30px; display: grid; place-items: center; border: 0; border-radius: var(--radius); background: 0; color: var(--color-text-muted); cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
.tb-view button svg { width: 18px; height: 18px; }
.tb-view button:hover { color: var(--color-primary); }
.tb-view button.on { background: var(--color-surface); color: var(--color-primary); box-shadow: 0 2px 6px -2px rgba(51, 92, 129, .4); }

/* ============================================================
   عرض الكروت — كرت العضو «بترويسة Aurora» · .mc
   ============================================================ */
.mc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(252px, 1fr)); gap: 18px; }
/* سطح Aurora: تدرّج ناعم + توهّج فولاذيّ ملوّن */
.mc {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-bottom: 0;
  overflow: hidden;
  border-radius: var(--radius);
  /* نفس وصفة Aurora المعتمدة في .acard حرفيًّا */
  border: 1px solid color-mix(in oklab, var(--steel-600) 10%, var(--color-border));
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-600) 12%, var(--color-surface)), var(--color-surface) 62%);
  box-shadow: 0 16px 36px -20px rgba(51, 92, 129, 0.42);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}
.mc:hover { transform: scale(var(--hover-scale)); border-color: var(--navy-700); box-shadow: 0 24px 46px -24px rgba(51, 92, 129, 0.5); }
/* الشريط العلويّ: تدرّج لوني الهوية من الزاوية + بلوم Aurora + باترن الهوية */
.mc-head {
  position: relative;
  width: 100%;
  height: 72px;
  overflow: hidden;
  background: var(--grad-primary-strong);
}
.mc-head::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(150px 100px at 20% -10%, rgba(111, 151, 192, .6), transparent 70%);
  pointer-events: none;
}
.mc-head::after {
  content: "";
  position: absolute;
  inset: 0;
  background: url("/brand/pattern-white.svg") no-repeat center / cover;
  opacity: .18;
  pointer-events: none;
}
.mc-head .mc-dots, .mc-head > span { position: absolute; top: 8px; inset-inline-end: 8px; z-index: 1; }
.mc-dots { width: 30px; height: 30px; border-radius: var(--radius); border: 0; background: rgba(255, 255, 255, .12); color: rgba(255, 255, 255, .95); cursor: pointer; display: grid; place-items: center; transition: background var(--dur-fast); }
.mc-dots svg { width: 18px; height: 18px; }
.mc-dots:hover, .mc-dots[aria-expanded="true"] { background: rgba(255, 255, 255, .28); color: #fff; }
.mc .mc-av { margin-top: -37px; box-shadow: 0 10px 22px -8px rgba(51, 92, 129, .6), 0 0 0 4px var(--color-surface), inset 0 0 0 1px rgba(255, 255, 255, .22); }
.mc-name { margin-top: 11px; font-size: 16.5px; font-weight: 800; color: var(--color-primary); padding: 0 14px; }
/* الدور واللجنة — شارة ناعمة */
.mc-role {
  display: inline-block;
  margin-top: 8px;
  padding: 4px 13px;
  border-radius: var(--radius-full);
  font-size: 12.5px;
  font-weight: 700;
  color: var(--steel-600);
  background: color-mix(in oklab, var(--steel-500) 13%, var(--color-surface));
  border: 1px solid color-mix(in oklab, var(--steel-500) 20%, transparent);
}
/* حساب موقوف — حبّة حمراء (درجة الشارات) */
.mc-role-danger {
  color: color-mix(in oklab, var(--danger-500), #000 6%);
  background: color-mix(in oklab, var(--danger-500) 12%, var(--color-surface));
  border-color: color-mix(in oklab, var(--danger-500) 26%, transparent);
}
/* البيانات الأساسية — صفوف نظيفة بأيقونات مؤطّرة (بلا شريط محيط) */
.mc-info {
  width: calc(100% - 34px);
  margin: 14px 17px 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}
.mc-info-row {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 9px 2px;
  border-bottom: 1px solid color-mix(in oklab, var(--steel-500) 11%, transparent);
  text-align: start;
}
.mc-info-row:last-child { border-bottom: 0; }
.mc-ic {
  width: 30px; height: 30px; flex: 0 0 auto;
  border-radius: var(--radius); display: grid; place-items: center;
  color: var(--steel-600);
  background: linear-gradient(135deg, color-mix(in oklab, var(--steel-500) 20%, var(--color-surface)), color-mix(in oklab, var(--steel-500) 8%, var(--color-surface)));
}
.mc-ic svg { width: 16px; height: 16px; }
.mc-info-txt { display: flex; flex-direction: column; min-width: 0; line-height: 1.35; }
.mc-info-label { font-size: 11px; font-weight: 600; color: var(--color-text-muted); }
/* وزن demi (600): أثقل من medium؛ وعنده الأرقام (مباشرة أو عبر التحويل) كلّها eras-demi متطابقة */
.mc-info-val { min-width: 0; font-size: 13px; font-weight: 600; color: var(--color-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: start; unicode-bidi: plaintext; }
/* سبب إنهاء العضوية قد يكون جملة — يلتفّ على أسطر (الأيقونة أعلى الصفّ) */
.mc-info-row-top { align-items: flex-start; }
.mc-info-reason { white-space: normal; overflow: visible; text-overflow: clip; line-height: 1.5; }
/* خليّة السبب في الجدول تلتفّ بدل سطر واحد طويل */
.dt-c .txt-wrap { white-space: normal; line-height: 1.45; }
/* تذييل الكرت: قسم مستقلّ للأزرار (الزرّ الرئيسيّ بعرض كامل) */
.mc-foot { width: 100%; margin-top: 16px; padding: 14px 16px; border-top: 1px solid color-mix(in oklab, var(--steel-600) 12%, var(--color-border)); background: color-mix(in oklab, var(--steel-600) 4%, var(--color-surface)); display: flex; flex-direction: column; gap: 8px; }
.mc-foot .abtn { width: 100%; }
/* صفّ زرّين كحدّ أقصى (عرض · حذف نهائي)؛ على الجوال يُكدّسان كامليْ العرض */
.mc-foot-row { display: flex; gap: 8px; }
.mc-foot-row .abtn { width: auto; flex: 1; min-width: 0; }
@media (max-width: 640px) {
  .mc-foot-row { flex-direction: column; }
  .mc-foot-row .abtn { flex: none; width: 100%; }
}

/* تذييل الترقيم في عرض الكروت (منفصل) + الحالة الفارغة */
.mc-pager { margin-top: 14px; border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; background: var(--color-surface); box-shadow: var(--shadow-md); }
.mc-empty { border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); box-shadow: var(--shadow-md); }

