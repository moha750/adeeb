/* ============================================================
   نظام رموز نادي أديب (Design Tokens) — V2
   المصدر الوحيد لكل ألوان وخطوط ومسافات الموقع.
   ⚠️ لا تُعرّف ألوانًا أو :root في أي ملف آخر — أضِفها هنا فقط.
   مبني على الهوية الرسمية: كحلي #274060 + فولاذي #335C81
   ============================================================ */

:root{
  color-scheme: light dark;

  /* ---------- (1) ألوان أولية: مقاييس العلامة ---------- */
  /* الكحلي (أساسي) — 700 هو لون العلامة الرسمي */
  --navy-50:#eff2f7;  --navy-100:#dde3ed; --navy-200:#bcc9dc; --navy-300:#8ea0bc;
  --navy-400:#5e779c; --navy-500:#456691; --navy-600:#33527a; --navy-700:#274060;
  --navy-800:#1e3350; --navy-900:#16263a; --navy-950:#0e1826;

  /* الفولاذي (ثانوي) — 600 هو اللون الثانوي الرسمي */
  --steel-50:#eef3f8; --steel-100:#dce5ef; --steel-200:#bccfe0; --steel-300:#92aac3;
  --steel-400:#5e88ab; --steel-500:#45719a; --steel-600:#335c81; --steel-700:#294c6c;
  --steel-800:#213d57; --steel-900:#1b3145;

  /* رمادِيّات محايدة (بميل كحلي خفيف — مختارة لا افتراضية) */
  --neutral-50:#f6f7fa; --neutral-100:#eceef2; --neutral-200:#dce0e7; --neutral-300:#c2c8d2;
  --neutral-400:#99a1af; --neutral-500:#6f7789; --neutral-600:#545c6d; --neutral-700:#414857;
  --neutral-800:#2a2f3a; --neutral-900:#191d25;

  /* دلالية — مقاييس تونيّة كاملة (كالكحلي/الفولاذي)، والأساس 600 */
  --success-50:#e9f8f0; --success-100:#cdeede; --success-200:#a0e0c1; --success-300:#63cd9c; --success-400:#35b57f;
  --success-500:#1f9d5f; --success-600:#1a8452; --success-700:#166a43; --success-800:#125334; --success-900:#0e3f28;
  --warning-50:#fdf4e3; --warning-100:#f9e6bf; --warning-200:#f2cd82; --warning-300:#ebb14a; --warning-400:#e39f24;
  --warning-500:#d9920f; --warning-600:#b87a0c; --warning-700:#94620b; --warning-800:#6f4a0a; --warning-900:#4d3308;
  --danger-50:#fceceb; --danger-100:#f9d6d2; --danger-200:#f2aaa3; --danger-300:#e87a6f; --danger-400:#dd5546;
  --danger-500:#d23b2c; --danger-600:#b52f22; --danger-700:#93261b; --danger-800:#6f1d15; --danger-900:#4d1410;
  --success:var(--success-600); --success-soft:var(--success-50);
  --warning:var(--warning-600); --warning-soft:var(--warning-50);
  --danger:var(--danger-600);   --danger-soft:var(--danger-50);
  --info:#335c81;               --info-soft:#e4ebf2;

  /* ---------- (1ج) ألوان المخطّطات (فئات بيانيّة) ----------
     مرتكزة على الهوية: فولاذيّ (1) + كحليّ (2)، ثمّ لكنات متناسقة للسلاسل الإضافيّة.
     نطاق مستقلّ عن لوحة العلامة عمدًا — تعدّد السلاسل يحتاج تمايزًا لا توفّره الهوية وحدها. */
  --chart-1:var(--steel-500); --chart-2:var(--navy-700); --chart-3:#b0812f;
  --chart-4:#2f8a7f;          --chart-5:#9c5b86;          --chart-6:#c06a3a;

  /* ---------- (1ب) تدرّجات الهوية الزاويّة (135°) ----------
     قاعدة العلامة: اللونان الرئيسيان (الفولاذي + الكحلي) لا ينفصلان أبدًا،
     يأتيان دائمًا معًا كتدرّج زاويّ. والألوان الدلالية الثلاثة (أحمر/أصفر/أخضر)
     تُعبَّأ كتدرّج زاويّ من الدرجة نفسها (فاتح→غامق)، لا لونًا صلبًا وحده.
     تُستخدَم هذه الرموز في كلّ «تعبئة» لونية بدل القيمة الصلبة. */
  /* تدرّج هوية واحد معتمَد (‎steel-400 → navy-800‎)؛ primary وstrong وhover كلّها تشير إليه */
  --grad-primary:linear-gradient(135deg, var(--steel-400), var(--navy-800));
  --grad-primary-strong:var(--grad-primary);
  --grad-primary-hover:var(--grad-primary);
  --grad-info:var(--grad-primary);
  /* الدلاليّة الثلاثة = نظام تدرّج الهوية مطبَّقًا: خطوة فاتحة (300) ← الأساس (600) بزاوية 135° */
  --grad-success:linear-gradient(135deg, var(--success-300), var(--success-600));
  --grad-warning:linear-gradient(135deg, var(--warning-300), var(--warning-600));
  --grad-danger:linear-gradient(135deg, var(--danger-300), var(--danger-600));

  /* ---------- (2) رموز دلالية (Semantic) — تنقلب مع الثيم ---------- */
  --color-bg:#f5f7fa;
  --color-surface:#ffffff;
  --color-surface-2:#eef1f6;
  --color-text:#182031;
  --color-text-muted:#5c6678;
  --color-border:rgba(24,32,49,.12);
  --color-primary:var(--navy-700);
  --color-primary-hover:var(--navy-800);
  --color-on-primary:#ffffff;
  --color-secondary:var(--steel-600);
  --color-secondary-hover:var(--steel-700);
  --color-on-secondary:#ffffff;
  --color-ring:var(--steel-500);
  /* الزرّ الشبحيّ المحايد — فولاذيّ في الفاتح، أبيض في الداكن (رمز ينقلب مع الثيم) */
  --btn-ghost-fg:var(--steel-600);
  --btn-ghost-border:color-mix(in oklab, var(--steel-600) 32%, transparent);

  /* ---------- (2ب) سطح Aurora المعتمَد — تعبئة مسطّحة ناعمة (~12%) + حدّ فولاذيّ ممزوج ---------- */
  --surface-aurora:linear-gradient(135deg, color-mix(in oklab, #45719a 14%, var(--color-surface)), var(--color-surface) 62%);
  --border-aurora:color-mix(in oklab, #45719a 20%, var(--color-border));
  /* زجاج فوق الأسطح المتدرّجة (ترويسات المجالس · الشارة الزجاجيّة) — طبقة بيضاء شفّافة موحّدة */
  --glass-bg:rgba(255,255,255,.16); --glass-bg-strong:rgba(255,255,255,.28); --glass-border:rgba(255,255,255,.28);

  /* ---------- (3) الطباعة ---------- */
  /* خطوط الهوية فقط — لا خطوط نظام محلية ولا خارجية.
     الكلمات المفردة (serif/sans-serif) ليست خطوطًا بل فئة احتياط أخيرة يفرضها CSS
     ولا تظهر إلا لو فشل تحميل خط الهوية (وهو مُضمّن، فلن يحدث). */
  --font-display:"Lyon Arabic",serif;   /* العناوين (عربي) */
  --font-body:"Lyon Arabic",sans-serif; /* النص العربي */
  --font-latin:"Eras",sans-serif;       /* اللاتيني/الأرقام */
  --font-mono:monospace;

  --text-xs:.75rem; --text-sm:.875rem; --text-base:1rem; --text-lg:1.125rem;
  --text-xl:1.25rem; --text-2xl:1.5rem; --text-3xl:1.875rem; --text-4xl:2.25rem;
  --text-5xl:3rem; --text-6xl:3.75rem;

  --leading-tight:1.15; --leading-snug:1.35; --leading-normal:1.6; --leading-relaxed:1.8;
  --fw-light:300; --fw-regular:400; --fw-medium:500; --fw-bold:700; --fw-black:900;
  --tracking-wide:.04em; --tracking-wider:.14em;

  /* ---------- (4) المسافات (أساس 4px) ---------- */
  --space-1:.25rem; --space-2:.5rem; --space-3:.75rem; --space-4:1rem; --space-5:1.25rem;
  --space-6:1.5rem; --space-8:2rem; --space-10:2.5rem; --space-12:3rem; --space-16:4rem;
  --space-20:5rem; --space-24:6rem;

  /* ---------- (5) الزوايا / الظلال / الطبقات ---------- */
  /* سلّم الزوايا حسب حجم العنصر — المصدر الوحيد. القاعدة: الاستدارة تتبع الحجم.
     صغير جدًّا (< 32px) → 8 · الأغلب → 16 · حبوب/دوائر → full.
     (لا رقم واحد يصلح للكل: 16 على عنصر 28px يقلبه دائرة، والنسبة تكسر المستطيلات — لذا سلّم.) */
  --radius:16px;      /* الأغلب: أزرار · حقول · كروت · نوافذ · أفتار متوسّطة فأكبر */
  --radius-sm:8px;    /* الصغير جدًّا: checkbox · زرّ المبدّل · الأفتار الصغيرة · أزرار الأيقونات الصغيرة */
  --radius-md:16px; --radius-lg:16px; --radius-xl:16px; --radius-full:9999px;

  /* ظلّ واحد موحّد بلون موسوم — الافتراضيّ لون الهوية (فولاذيّ)، ويتغيّر للدلاليّ عبر --shadow-tone */
  --shadow-tone:69,113,154;   /* steel-500 */
  --shadow-sm:0 4px 16px -2px rgba(var(--shadow-tone),.25);
  --shadow-md:var(--shadow-sm); --shadow-lg:var(--shadow-sm);

  --z-base:0; --z-dropdown:1000; --z-sticky:1100; --z-modal:1300; --z-toast:1500;

  /* ---------- (6) الحركة ---------- */
  --ease-standard:cubic-bezier(.2,.6,.2,1);
  --dur-fast:.15s; --dur:.25s; --dur-slow:.4s;
  --hover-scale:1.02;   /* تكبير موحّد لمرور الكروت التفاعليّة (كرت العضو · البطاقة · الإحصائيات) */
}

/* ============ الوضع الداكن (تفضيل النظام) ============ */
@media (prefers-color-scheme:dark){
  :root{
    --color-bg:#0f141c; --color-surface:#161d29; --color-surface-2:#1d2634;
    --color-text:#e9edf3; --color-text-muted:#9aa5b6; --color-border:rgba(233,237,243,.13);
    --color-primary:var(--navy-600); --color-primary-hover:var(--navy-500);
    --color-secondary:var(--steel-500); --color-secondary-hover:var(--steel-400);
    --color-ring:var(--steel-400);
    --btn-ghost-fg:#ffffff; --btn-ghost-border:rgba(255,255,255,.5);
    --success-soft:rgba(46,139,107,.14); --warning-soft:rgba(197,138,44,.16);
    --danger-soft:rgba(192,71,60,.16);  --info-soft:rgba(51,92,129,.18);
    --shadow-sm:0 1px 2px rgba(0,0,0,.4);
    --shadow-md:0 6px 16px -8px rgba(0,0,0,.55);
    --shadow-lg:0 24px 50px -30px rgba(0,0,0,.7);
  }
}

/* ============ تجاوز يدوي للثيم (زر التبديل يضع data-theme على :root) ============ */
:root[data-theme="light"]{
  --color-bg:#f5f7fa; --color-surface:#ffffff; --color-surface-2:#eef1f6;
  --color-text:#182031; --color-text-muted:#5c6678; --color-border:rgba(24,32,49,.12);
  --color-primary:var(--navy-700); --color-primary-hover:var(--navy-800);
  --color-secondary:var(--steel-600); --color-secondary-hover:var(--steel-700); --color-ring:var(--steel-500);
  --btn-ghost-fg:var(--steel-600); --btn-ghost-border:color-mix(in oklab, var(--steel-600) 32%, transparent);
  --success-soft:var(--success-50); --warning-soft:var(--warning-50); --danger-soft:var(--danger-50); --info-soft:#e4ebf2;
}
:root[data-theme="dark"]{
  --color-bg:#0f141c; --color-surface:#161d29; --color-surface-2:#1d2634;
  --color-text:#e9edf3; --color-text-muted:#9aa5b6; --color-border:rgba(233,237,243,.13);
  --color-primary:var(--navy-600); --color-primary-hover:var(--navy-500);
  --color-secondary:var(--steel-500); --color-secondary-hover:var(--steel-400); --color-ring:var(--steel-400);
  --btn-ghost-fg:#ffffff; --btn-ghost-border:rgba(255,255,255,.5);
  --success-soft:rgba(46,139,107,.14); --warning-soft:rgba(197,138,44,.16);
  --danger-soft:rgba(192,71,60,.16);  --info-soft:rgba(51,92,129,.18);
}
