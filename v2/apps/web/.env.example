# متغيّرات البيئة — نسخةٌ للنسخ لا للتعبئة بالحقيقيّ
#
# انسخ هذا الملفّ إلى `.env.local` (وهو مُستثنًى من git) واملأ القيم.
# وكلُّ ما ليس عليه `NEXT_PUBLIC_` **سرٌّ خادميّ** لا يُستورد في كود العميل أبدًا:
# ما يُبادَأ بـ`NEXT_PUBLIC_` يُدمَج في حزم المتصفّح ويقرؤه كلُّ زائر.
#
# القائمةُ مجرودةٌ من الشيفرة نفسِها (`process.env.*` في apps/web و packages و scripts)
# في ٢٠٢٦-٠٨-١٦، لا مكتوبةً من الذاكرة. وأيُّ متغيّرٍ جديدٍ يُضاف هنا في التغيير نفسِه.

# ══ Supabase — لازمةٌ لتشغيل التطبيق أصلًا ══════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة: يتجاوز RLS. خادميٌّ محض (تحميلُ الهويّة والقدرات، والأفعال المميَّزة).
SUPABASE_SERVICE_ROLE_KEY=

# ══ الموقع ═════════════════════════════════════════════════════════════════
# أصلُ الروابط في metadataBase وبطاقات OG. غيابُه يرجع إلى https://adeeb.club
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ══ درع Turnstile — دخولٌ واستعادةٌ واستبياناتٌ وحجزٌ وتواصل ═════════════════
# غيابُ السرّ يُسقط الدرع في التطوير بلا كسر، ووجودُه يفرضه. وفي الإنتاج **لا يجوز غيابُه**.
# وإن جرّبتَ من جوّالٍ على الشبكة المحلّيّة فأضِف عنوان الجهاز إلى نطاقات الودجة المسموحة،
# وإلّا ردّ كلاودفلير بـ110200 ولم يُصدِر رمزًا، فيفشل الدخول صامتًا.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ══ Cloudflare R2 — صوتُ الإذاعة وشعاراتُ البرامج ══════════════════════════
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adeeb-radio
R2_PUBLIC_BASE=

# ══ البريد ═════════════════════════════════════════════════════════════════
# Resend: إعدادُ SMTP في Supabase (pnpm auth:config) ودالّةُ ردّ التواصل.
RESEND_API_KEY=

# ══ إعدادُ المصادقة من المستودع (pnpm auth:config) ═════════════════════════
# رمزُ واجهة الإدارة في Supabase — لا يلزم لتشغيل التطبيق، بل لتطبيق الإعداد والقوالب.
SUPABASE_ACCESS_TOKEN=
GOOGLE_OAUTH_SECRET=
# سرُّ أبل يُولَّد بـ`node scripts/apple-secret.mjs` **وينتهي صامتًا** (تاريخُ الحاليّ 2027-02-01).
APPLE_OAUTH_SECRET=
APPLE_KEY_ID=
APPLE_KEY_FILE=./AuthKey_XXXXXXXXXX.p8

# ══ المحافظ — بطاقة الولاء ═════════════════════════════════════════════════
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=
WALLET_PASS_TYPE_ID=
WALLET_TEAM_ID=
# مادّةُ التوقيع (PEM متعدّدُ الأسطر — يُحاط بعلامتَي اقتباس ويُكتب فيه \n)
WALLET_PASS_CERT_PEM=
WALLET_PASS_KEY_PEM=
WALLET_PASS_KEY_PASSPHRASE=
WALLET_WWDR_PEM=

# ══ ديبو — المساعد الآليّ ═══════════════════════════════════════════════════
# مفاتيحُ المزوّدين. ثلاثتُها اختياريّة: المزوّدُ الذي لا مفتاحَ له يردّ خطأً
# مقروءًا في مختبر `/ui/deebo-compare` ويبقى إخوتُه يعملون، فيُقارَن اثنان قبل
# أن يُصدَر الثالث. ولا يُنادى أيٌّ منها إلّا من فعلٍ خادميّ.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# معرّفا نموذجَي جوجل وديب‑سيك يتبدّلان مع إصداراتهما، فيُنقَضان من هنا بلا
# تعديل كود إن ردّ المزوّد «نموذجٌ غير معروف». ومعرّفُ Claude ثابتٌ في الكود.
GEMINI_MODEL=
DEEPSEEK_MODEL=
# أيُّ مزوّدٍ يخدم المحادثة الحيّة. تبديلُ ديبو كلِّه من نموذجٍ إلى آخر = تبديلُ
# هذه القيمة وحدها: sonnet | haiku | gemini | deepseek. والافتراض deepseek.
DEEBO_PROVIDER=deepseek
# ملحُ بصمة الزائر. البصمة `sha256(ip‖salt‖تاريخ اليوم)` فتدور يوميًّا: تكفي
# لمنع الاستنزاف ولا تصلح لتتبّع زائرٍ عبر الأيّام. **لا تُغيّره بعد النشر.**
DEEBO_SALT=
# سقفُ الإنفاق اليوميّ بالدولار (حارسُ فاتورة، لا هدف). الافتراض 0.20
DEEBO_DAILY_USD_CAP=0.20
# أقصى رسائل للزائر الواحد في الساعة. الافتراض 20
DEEBO_MAX_PER_HOUR=20

# ══ التطوير ════════════════════════════════════════════════════════════════
# منفذ خادم التطوير (scripts/dev-server.mjs)، والافتراض 3000
PORT=3000
