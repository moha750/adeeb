{
  "name": "adeeb-v2",
  "private": true,
  "version": "0.0.0",
  "description": "إعادة بناء موقع نادي أديب — النسخة الثانية (Monorepo)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:start": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:restart": "node scripts/dev-server.mjs restart",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:logs": "node scripts/dev-server.mjs logs",
    "check": "node scripts/check.mjs",
    "auth:config": "node scripts/auth-config.mjs",
    "web": "pnpm --filter web dev",
    "app": "pnpm --filter mobile start",
    "app:ios": "pnpm --filter mobile ios",
    "app:phone": "pnpm --filter mobile ios:device",
    "app:android": "pnpm --filter mobile android",
    "theme:native": "node scripts/theme-native.mjs",
    "r2:cors": "node scripts/r2-cors.mjs",
    "deebo:art": "node scripts/deebo-art.mjs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    },
    "overrides": {
      "react": "19.2.4",
      "@react-native/metro-config": "0.86.2"
    }
  }
}
